{
  "name": "@loaders.gl/scientific",
  "version": "5.0.0",
  "description": "Scientific NumPy arrays and sources for NetCDF, Zarr, GRIB2, HDF5, and VTK",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./netcdf": {
      "types": "./dist/netcdf/metadata-entry.d.ts",
      "import": "./dist/netcdf/metadata-entry.js",
      "require": "./dist/netcdf/metadata-entry.cjs"
    },
    "./zarr": {
      "types": "./dist/zarr/metadata-entry.d.ts",
      "import": "./dist/zarr/metadata-entry.js",
      "require": "./dist/zarr/metadata-entry.cjs"
    },
    "./grib2": {
      "types": "./dist/grib2/index.d.ts",
      "import": "./dist/grib2/index.js",
      "require": "./dist/grib2/index.cjs"
    },
    "./scientific-array": {
      "types": "./dist/scientific-array.d.ts",
      "import": "./dist/scientific-array.js",
      "require": "./dist/scientific-array.cjs"
    },
    "./hdf5": {
      "types": "./dist/hdf5/index.d.ts",
      "import": "./dist/hdf5/index.js",
      "require": "./dist/hdf5/index.cjs"
    },
    "./vtk": {
      "types": "./dist/vtk/metadata-entry.d.ts",
      "import": "./dist/vtk/metadata-entry.js",
      "require": "./dist/vtk/metadata-entry.cjs"
    },
    "./vector-field": {
      "types": "./dist/vector-field/index.d.ts",
      "import": "./dist/vector-field/index.js",
      "require": "./dist/vector-field/index.cjs"
    },
    "./npy-worker.js": {
      "import": "./dist/npy-worker.js"
    },
    "./npy": {
      "types": "./dist/npy/metadata-entry.d.ts",
      "import": "./dist/npy/metadata-entry.js",
      "require": "./dist/npy/metadata-entry.cjs"
    },
    "./nrrd": {
      "types": "./dist/nrrd/metadata-entry.d.ts",
      "import": "./dist/nrrd/metadata-entry.js",
      "require": "./dist/nrrd/metadata-entry.cjs"
    },
    "./netcdf/bundled": {
      "types": "./dist/netcdf-bundled-entry.d.ts",
      "import": "./dist/netcdf-bundled-entry.js",
      "require": "./dist/netcdf-bundled-entry.cjs"
    },
    "./zarr/bundled": {
      "types": "./dist/zarr-bundled-entry.d.ts",
      "import": "./dist/zarr-bundled-entry.js",
      "require": "./dist/zarr-bundled-entry.cjs"
    },
    "./vtk/bundled": {
      "types": "./dist/vtk-bundled-entry.d.ts",
      "import": "./dist/vtk-bundled-entry.js",
      "require": "./dist/vtk-bundled-entry.cjs"
    },
    "./npy/bundled": {
      "types": "./dist/npy-bundled.d.ts",
      "import": "./dist/npy-bundled.js",
      "require": "./dist/npy-bundled.cjs"
    },
    "./nrrd/bundled": {
      "types": "./dist/nrrd-bundled.d.ts",
      "import": "./dist/nrrd-bundled.js",
      "require": "./dist/nrrd-bundled.cjs"
    },
    "./pdb": {
      "types": "./dist/pdb/metadata-entry.d.ts",
      "import": "./dist/pdb/metadata-entry.js",
      "require": "./dist/pdb/metadata-entry.cjs"
    },
    "./pdb/bundled": {
      "types": "./dist/pdb-bundled.d.ts",
      "import": "./dist/pdb-bundled.js",
      "require": "./dist/pdb-bundled.cjs"
    },
    "./netcdf/api": {
      "types": "./dist/netcdf-api.d.ts",
      "import": "./dist/netcdf-api.js",
      "require": "./dist/netcdf-api.cjs"
    },
    "./zarr/api": {
      "types": "./dist/zarr-api.d.ts",
      "import": "./dist/zarr-api.js",
      "require": "./dist/zarr-api.cjs"
    },
    "./vtk/api": {
      "types": "./dist/vtk-api.d.ts",
      "import": "./dist/vtk-api.js",
      "require": "./dist/vtk-api.cjs"
    },
    "./adsb": {
      "types": "./dist/adsb/index.d.ts",
      "import": "./dist/adsb/index.js",
      "require": "./dist/adsb/index.cjs"
    },
    "./adsb/bundled": {
      "types": "./dist/adsb/bundled.d.ts",
      "import": "./dist/adsb/bundled.js",
      "require": "./dist/adsb/bundled.cjs"
    },
    "./ais": {
      "types": "./dist/ais/index.d.ts",
      "import": "./dist/ais/index.js",
      "require": "./dist/ais/index.cjs"
    },
    "./ais/bundled": {
      "types": "./dist/ais/bundled.d.ts",
      "import": "./dist/ais/bundled.js",
      "require": "./dist/ais/bundled.cjs"
    },
    "./omm": {
      "types": "./dist/omm/index.d.ts",
      "import": "./dist/omm/index.js",
      "require": "./dist/omm/index.cjs"
    },
    "./omm/bundled": {
      "types": "./dist/omm/bundled.d.ts",
      "import": "./dist/omm/bundled.js",
      "require": "./dist/omm/bundled.cjs"
    },
    "./tle": {
      "types": "./dist/tle/index.d.ts",
      "import": "./dist/tle/index.js",
      "require": "./dist/tle/index.cjs"
    },
    "./tle/bundled": {
      "types": "./dist/tle/bundled.d.ts",
      "import": "./dist/tle/bundled.js",
      "require": "./dist/tle/bundled.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "build-format-subpaths": "node ../../scripts/build-format-subpaths.mjs",
    "pre-build": "npm run build-format-subpaths && npm run build-bundle && npm run build-bundle-dev && npm run build-cjs-netcdf && npm run build-cjs-zarr && npm run build-cjs-grib2 && npm run build-cjs-hdf5 && npm run build-cjs-vtk && npm run build-cjs-vector-field && npm run build-npy-worker && npm run build-metadata && npm run build-cjs-vtk-loader && npm run build-cjs-nrrd && npm run build-cjs-pdb",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./netcdf-bundle.ts --output=dist/netcdf.min.js && node ../../scripts/build-codec-bundle.mjs ./zarr-bundle.ts --output=dist/zarr.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./netcdf-bundle.ts --env=dev --output=dist/netcdf.dev.js && node ../../scripts/build-codec-bundle.mjs ./zarr-bundle.ts --env=dev --output=dist/zarr.dev.js",
    "build-cjs-netcdf": "esbuild src/netcdf/*.ts --bundle --format=cjs --platform=node --target=node22 --outdir=dist/netcdf --out-extension:.js=.cjs --external:@loaders.gl/* --external:@math.gl/*",
    "build-cjs-zarr": "esbuild src/zarr-bundled-entry.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/zarr-bundled-entry.cjs --external:@loaders.gl/* --external:@math.gl/* && esbuild src/zarr-api.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/zarr-api.cjs --external:@loaders.gl/* --external:@math.gl/*",
    "build-cjs-grib2": "esbuild src/grib2/index.ts src/scientific-array.ts --bundle --format=cjs --platform=node --target=node22 --outdir=dist --out-extension:.js=.cjs --external:@loaders.gl/*",
    "build-cjs-hdf5": "esbuild src/hdf5/index.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/hdf5/index.cjs --external:@loaders.gl/*",
    "build-cjs-vtk": "esbuild src/vtk/index.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/vtk/index.cjs --external:@loaders.gl/*",
    "build-cjs-vector-field": "esbuild src/vector-field/index.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/vector-field/index.cjs --external:@loaders.gl/*",
    "build-npy-worker": "esbuild src/workers/npy-worker.ts --outfile=dist/npy-worker.js --target=esnext --bundle --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-metadata": "node ../../scripts/build-scientific-metadata.mjs",
    "build-cjs-vtk-loader": "esbuild src/vtk-loader.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/vtk-loader.cjs --external:@loaders.gl/*",
    "build-cjs-nrrd": "esbuild src/nrrd-loader.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/nrrd-loader.cjs --external:@loaders.gl/*",
    "build-cjs-pdb": "esbuild src/pdb-loader.ts --bundle --format=cjs --platform=node --target=node22 --outfile=dist/pdb-loader.cjs --external:@loaders.gl/*"
  },
  "dependencies": {
    "@loaders.gl/documents": "5.0.0",
    "@math.gl/core": "^5.0.3",
    "@math.gl/geospatial": "^5.0.3",
    "h5wasm": "^0.10.3",
    "zarr": "^0.5.0",
    "zarrita": "~0.7.1"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0",
    "apache-arrow": ">= 17.0.0"
  },
  "keywords": [
    "loaders.gl",
    "NetCDF",
    "NetCDF-4",
    "Zarr",
    "GeoZarr",
    "OME-Zarr",
    "SpatialData",
    "GRIB2",
    "HDF5",
    "VTK",
    "VTI",
    "VTR",
    "VTS",
    "VTU",
    "VTP",
    "cdf",
    "nc"
  ]
}
