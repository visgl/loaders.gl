{
  "name": "@loaders.gl/services",
  "version": "5.0.0-alpha.5",
  "description": "Framework-independent loaders and sources for geospatial services",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "ArcGIS",
    "services",
    "FeatureServer",
    "ImageServer",
    "MapServer",
    "geospatial",
    "loader"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./authentication": {
      "types": "./dist/authentication.d.ts",
      "import": "./dist/authentication.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@loaders.gl/gis": "5.0.0-alpha.5",
    "@loaders.gl/i3s": "5.0.0-alpha.5",
    "@loaders.gl/images": "5.0.0-alpha.5",
    "@loaders.gl/lerc": "5.0.0-alpha.5",
    "@loaders.gl/loader-utils": "5.0.0-alpha.5",
    "@loaders.gl/mvt": "5.0.0-alpha.5",
    "@loaders.gl/schema": "5.0.0-alpha.5"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
