{
  "name": "@loaders.gl/services",
  "version": "5.0.0-alpha.6",
  "description": "Authentication presets for geospatial service providers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "authentication",
    "services",
    "geospatial"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./authentication": {
      "types": "./dist/authentication.d.ts",
      "import": "./dist/authentication.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@loaders.gl/loader-utils": "5.0.0-alpha.6"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
