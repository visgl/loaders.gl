{
  "name": "@loaders.gl/services",
  "version": "5.0.0-alpha.12",
  "description": "Authentication and OGC/STAC geospatial service sources",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "authentication",
    "services",
    "geospatial"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./authentication": {
      "types": "./dist/authentication.d.ts",
      "import": "./dist/authentication.js"
    },
    "./stac": {
      "types": "./dist/stac/index.d.ts",
      "import": "./dist/stac/index.js"
    },
    "./stac/stac-source": {
      "types": "./dist/stac/stac-source.d.ts",
      "import": "./dist/stac/stac-source.js"
    },
    "./wms": {
      "types": "./dist/wms/index.d.ts",
      "import": "./dist/wms/index.js"
    },
    "./wms/unbundled": {
      "types": "./dist/wms/unbundled.d.ts",
      "import": "./dist/wms/unbundled.js"
    },
    "./wms/bundled": {
      "types": "./dist/wms/bundled.d.ts",
      "import": "./dist/wms/bundled.js"
    },
    "./wms/gml-loader": {
      "types": "./dist/wms/gml-loader.d.ts",
      "import": "./dist/wms/gml-loader.js"
    },
    "./wms/wmts-capabilities-loader-with-parser": {
      "types": "./dist/wms/wmts-capabilities-loader-with-parser.d.ts",
      "import": "./dist/wms/wmts-capabilities-loader-with-parser.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "dependencies": {
    "@loaders.gl/arrow-geometry": "5.0.0-alpha.12",
    "@loaders.gl/images": "5.0.0-alpha.12",
    "@loaders.gl/raster": "5.0.0-alpha.12",
    "@loaders.gl/xml": "5.0.0-alpha.12",
    "@math.gl/crs": "5.0.0-alpha.18",
    "@math.gl/geospatial": "5.0.0-alpha.18",
    "lerc": "^4.2.0"
  }
}
