{
  "name": "@loaders.gl/lerc",
  "version": "5.0.0-alpha.5",
  "description": "Framework-independent loader for LERC (Limited Error Raster Compression) files",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "parser",
    "LERC"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./lerc-worker.js": {
      "import": "./dist/lerc-worker.js"
    },
    "./lerc-wasm.wasm": "./dist/libs/lerc/lerc-wasm.wasm"
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run copy-wasm",
    "pre-build-2": "echo npm run build-bundle && npm run build-bundle-dev && npm run build-worker",
    "copy-wasm": "mkdir -p dist/libs/lerc && cp src/libs/lerc/lerc-wasm.wasm dist/libs/lerc/lerc-wasm.wasm",
    "build-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js --external:url --external:fs --external:path --external:module",
    "build-bundle-dev": "ocular-bundle ./bundle.ts --env=dev --output=dist/dist.dev.js --external:url --external:fs --external:path --external:module",
    "build-worker": "esbuild src/workers/lerc-worker.ts --bundle --outfile=dist/lerc-worker.js --define:__VERSION__=\\\"$npm_package_version\\\" --external:url --external:fs --external:path --external:module"
  },
  "dependencies": {
    "@loaders.gl/loader-utils": "5.0.0-alpha.5",
    "@loaders.gl/schema": "5.0.0-alpha.5",
    "lerc": "^4.2.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
