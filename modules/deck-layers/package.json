{
  "name": "@loaders.gl/deck-layers",
  "version": "5.0.0-beta.1",
  "description": "Source-oriented deck.gl layers for loaders.gl data sources",
  "license": "MIT",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "deck.gl",
    "layer",
    "examples",
    "loader",
    "loaders.gl"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "echo \"Nothing to build in @loaders.gl/deck-layers\""
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@loaders.gl/archives": "5.0.0-beta.1",
    "@loaders.gl/compression": "5.0.0-beta.1",
    "@loaders.gl/tables": "5.0.0-beta.1",
    "@loaders.gl/tiles": "5.0.0-beta.1",
    "@loaders.gl/tiles-3d": "5.0.0-beta.1",
    "@luma.gl/core": "^9.4.0",
    "@luma.gl/engine": "^9.4.0",
    "@luma.gl/shadertools": "^9.4.0",
    "@math.gl/core": "5.0.0-beta.1",
    "@math.gl/geometry": "5.0.0-beta.1",
    "@math.gl/web-mercator": "5.0.0-beta.1",
    "apache-arrow": ">= 17.0.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
