{
  "name": "@loaders.gl/scene",
  "version": "5.0.0-beta.2",
  "description": "glTF, GLB, OBJ, MTL, OpenUSD, and Draco geometry loaders and writers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loader",
    "3d",
    "scene",
    "OpenUSD",
    "USD",
    "USDA",
    "USDZ",
    "loaders.gl",
    "glTF",
    "GLB",
    "OBJ",
    "MTL"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./usd-loader": {
      "types": "./dist/usd-loader.d.ts",
      "import": "./dist/usd-loader.js",
      "require": "./dist/usd-loader.cjs"
    },
    "./obj": {
      "types": "./dist/obj/index.d.ts",
      "import": "./dist/obj/index.js",
      "require": "./dist/obj/index.cjs"
    },
    "./obj/bundled": {
      "types": "./dist/obj/bundled.d.ts",
      "import": "./dist/obj/bundled.js",
      "require": "./dist/obj/bundled.cjs"
    },
    "./obj/index": {
      "types": "./dist/obj/index.d.ts",
      "import": "./dist/obj/index.js",
      "require": "./dist/obj/index.cjs"
    },
    "./obj/mtl-format": {
      "types": "./dist/obj/mtl-format.d.ts",
      "import": "./dist/obj/mtl-format.js",
      "require": "./dist/obj/mtl-format.cjs"
    },
    "./mtl-loader-types": {
      "types": "./dist/mtl-loader-types.d.ts",
      "import": "./dist/mtl-loader-types.js",
      "require": "./dist/mtl-loader-types.cjs"
    },
    "./mtl-loader": {
      "types": "./dist/mtl-loader.d.ts",
      "import": "./dist/mtl-loader.js",
      "require": "./dist/mtl-loader.cjs"
    },
    "./obj/obj-format": {
      "types": "./dist/obj/obj-format.d.ts",
      "import": "./dist/obj/obj-format.js",
      "require": "./dist/obj/obj-format.cjs"
    },
    "./obj-loader-types": {
      "types": "./dist/obj-loader-types.d.ts",
      "import": "./dist/obj-loader-types.js",
      "require": "./dist/obj-loader-types.cjs"
    },
    "./obj-loader": {
      "types": "./dist/obj-loader.d.ts",
      "import": "./dist/obj-loader.js",
      "require": "./dist/obj-loader.cjs"
    },
    "./obj-writer": {
      "types": "./dist/obj-writer.d.ts",
      "import": "./dist/obj-writer.js",
      "require": "./dist/obj-writer.cjs"
    },
    "./obj/unbundled": {
      "types": "./dist/obj/unbundled.d.ts",
      "import": "./dist/obj/unbundled.js",
      "require": "./dist/obj/unbundled.cjs"
    },
    "./gltf": {
      "types": "./dist/gltf/index.d.ts",
      "import": "./dist/gltf/index.js",
      "require": "./dist/gltf/index.cjs"
    },
    "./gltf/bundled": {
      "types": "./dist/gltf/bundled.d.ts",
      "import": "./dist/gltf/bundled.js",
      "require": "./dist/gltf/bundled.cjs"
    },
    "./glb-loader-types": {
      "types": "./dist/glb-loader-types.d.ts",
      "import": "./dist/glb-loader-types.js",
      "require": "./dist/glb-loader-types.cjs"
    },
    "./glb-loader": {
      "types": "./dist/glb-loader.d.ts",
      "import": "./dist/glb-loader.js",
      "require": "./dist/glb-loader.cjs"
    },
    "./glb-writer": {
      "types": "./dist/glb-writer.d.ts",
      "import": "./dist/glb-writer.js",
      "require": "./dist/glb-writer.cjs"
    },
    "./gltf/gltf-format": {
      "types": "./dist/gltf/gltf-format.d.ts",
      "import": "./dist/gltf/gltf-format.js",
      "require": "./dist/gltf/gltf-format.cjs"
    },
    "./gltf-loader-types": {
      "types": "./dist/gltf-loader-types.d.ts",
      "import": "./dist/gltf-loader-types.js",
      "require": "./dist/gltf-loader-types.cjs"
    },
    "./gltf-loader": {
      "types": "./dist/gltf-loader.d.ts",
      "import": "./dist/gltf-loader.js",
      "require": "./dist/gltf-loader.cjs"
    },
    "./gltf-source": {
      "types": "./dist/gltf-source.d.ts",
      "import": "./dist/gltf-source.js",
      "require": "./dist/gltf-source.cjs"
    },
    "./gltf-writer": {
      "types": "./dist/gltf-writer.d.ts",
      "import": "./dist/gltf-writer.js",
      "require": "./dist/gltf-writer.cjs"
    },
    "./gltf/index": {
      "types": "./dist/gltf/index.d.ts",
      "import": "./dist/gltf/index.js",
      "require": "./dist/gltf/index.cjs"
    },
    "./gltf/mesh-arrow": {
      "types": "./dist/gltf/mesh-arrow.d.ts",
      "import": "./dist/gltf/mesh-arrow.js"
    },
    "./gltf/schema": {
      "types": "./dist/gltf/schema.d.ts",
      "import": "./dist/gltf/schema.js"
    },
    "./gltf/unbundled": {
      "types": "./dist/gltf/unbundled.d.ts",
      "import": "./dist/gltf/unbundled.js",
      "require": "./dist/gltf/unbundled.cjs"
    },
    "./gltf/gltf.schema.json": "./dist/gltf/gltf.schema.json",
    "./gltf/gltf-1.schema.json": "./dist/gltf/gltf-1.schema.json",
    "./gltf/gltf-2.schema.json": "./dist/gltf/gltf-2.schema.json",
    "./gltf/gltf-2.1.schema.json": "./dist/gltf/gltf-2.1.schema.json",
    "./gltf/gltf-all.schema.json": "./dist/gltf/gltf-all.schema.json",
    "./gltf/schemas/*": "./dist/gltf/schemas/*",
    "./usd": {
      "types": "./dist/usd/index.d.ts",
      "import": "./dist/usd/index.js",
      "require": "./dist/usd/index.cjs"
    },
    "./obj-worker.js": {
      "import": "./dist/obj-worker.js"
    },
    "./usd/index": {
      "types": "./dist/usd/index.d.ts",
      "import": "./dist/usd/index.js",
      "require": "./dist/usd/index.cjs"
    },
    "./usd-loader-types": {
      "types": "./dist/usd-loader-types.d.ts",
      "import": "./dist/usd-loader-types.js",
      "require": "./dist/usd-loader-types.cjs"
    },
    "./draco-worker.js": {
      "import": "./dist/draco-worker.js"
    },
    "./draco-worker-node.js": {
      "import": "./dist/draco-worker-node.js"
    },
    "./draco-writer-worker.js": {
      "import": "./dist/draco-writer-worker.js"
    },
    "./draco-writer-worker-node.js": {
      "import": "./dist/draco-writer-worker-node.cjs",
      "require": "./dist/draco-writer-worker-node.cjs"
    },
    "./draco-writer-worker-node.cjs": {
      "require": "./dist/draco-writer-worker-node.cjs",
      "default": "./dist/draco-writer-worker-node.cjs"
    },
    "./draco-loader": {
      "types": "./dist/draco-loader.d.ts",
      "import": "./dist/draco-loader.js",
      "require": "./dist/draco-loader.cjs"
    },
    "./draco-loader-types": {
      "types": "./dist/draco-loader-types.d.ts",
      "import": "./dist/draco-loader-types.js",
      "require": "./dist/draco-loader-types.cjs"
    },
    "./draco-wasm-loader": {
      "types": "./dist/draco-wasm-loader.d.ts",
      "import": "./dist/draco-wasm-loader.js",
      "require": "./dist/draco-wasm-loader.cjs"
    },
    "./draco-javascript-loader": {
      "types": "./dist/draco-javascript-loader.d.ts",
      "import": "./dist/draco-javascript-loader.js",
      "require": "./dist/draco-javascript-loader.cjs"
    },
    "./draco3d-loader": {
      "types": "./dist/draco3d-loader.d.ts",
      "import": "./dist/draco3d-loader.js",
      "require": "./dist/draco3d-loader.cjs"
    },
    "./draco-writer": {
      "types": "./dist/draco-writer.d.ts",
      "import": "./dist/draco-writer.js",
      "require": "./dist/draco-writer.cjs"
    },
    "./draco-library-options": {
      "types": "./dist/draco-library-options.d.ts",
      "import": "./dist/draco-library-options.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "OBJ-README.md",
    "GLTF-README.md",
    "bin",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses",
    "DRACO-README.md"
  ],
  "scripts": {
    "pre-build": "npm run copy-libs-gltf && npm run build-worker-obj && npm run build-format-subpaths && npm run generate-gltf-schemas && npm run build-bundle && npm run build-bundle-dev && npm run copy-libs-draco && npm run build-draco-workers",
    "build-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "ocular-bundle ./bundle.ts --env=dev --output=dist/dist.dev.js",
    "build-worker-obj": "node ../../scripts/build-codec-worker.mjs src/obj/workers/obj-worker.ts --bundle --outfile=dist/obj-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-format-subpaths": "node ../../scripts/build-format-subpaths.mjs",
    "generate-gltf-schemas": "node scripts/gltf/generate-json-schema.mjs",
    "copy-libs-gltf": "mkdir -p dist/gltf/libs && cp -rf src/gltf/libs/. dist/gltf/libs/",
    "copy-libs-draco": "mkdir -p ./dist/libs && cp -rf ./src/draco/libs/. ./dist/libs && node ../../scripts/build-library-modules.mjs scene",
    "build-draco-workers": "yarn build-draco-loader-worker && yarn build-draco-loader-worker-node && yarn build-draco-writer-worker && yarn build-draco-writer-worker-node",
    "build-draco-loader-worker": "node ../../scripts/build-codec-worker.mjs src/draco/workers/draco-worker.ts --outfile=dist/draco-worker.js --target=esnext --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-draco-loader-worker-node": "node ../../scripts/build-codec-worker.mjs src/draco/workers/draco-worker-node.ts --outfile=dist/draco-worker-node.js --target=node16 --platform=node --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-draco-writer-worker": "node ../../scripts/build-codec-worker.mjs src/draco/workers/draco-writer-worker.ts --outfile=dist/draco-writer-worker.js --target=esnext --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-draco-writer-worker-node": "node ../../scripts/build-codec-worker.mjs src/draco/workers/draco-writer-worker-node.ts --outfile=dist/draco-writer-worker-node.cjs --target=node16 --platform=node --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\""
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "dependencies": {
    "@loaders.gl/images": "5.0.0-beta.2",
    "@math.gl/core": "5.0.0-beta.2",
    "@math.gl/geometry": "5.0.0-beta.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "meshoptimizer": "1.3.0"
  },
  "optionalDependencies": {
    "draco3d": "1.5.7"
  }
}
