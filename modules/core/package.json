{
  "name": "@loaders.gl/core",
  "version": "5.0.0-alpha.12",
  "description": "The core API for working with loaders.gl loaders and writers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loader",
    "parser",
    "writer",
    "encoder",
    "big data",
    "table",
    "3d",
    "mesh",
    "point cloud",
    "webgl",
    "webgpu"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loader-utils": {
      "types": "./dist/loader-utils/index.d.ts",
      "import": "./dist/loader-utils/index.js",
      "require": "./dist/loader-utils/index.cjs"
    },
    "./worker-utils": {
      "types": "./dist/worker-utils/index.d.ts",
      "import": "./dist/worker-utils/index.js",
      "require": "./dist/worker-utils/index.cjs"
    },
    "./worker-utils/null-worker.js": {
      "import": "./dist/worker-utils/null-worker.js"
    },
    "./worker-utils/null-worker-node.js": {
      "import": "./dist/worker-utils/null-worker-node.js"
    },
    "./null-worker.js": {
      "import": "./dist/null-worker.js"
    },
    "./null-worker-node.js": {
      "import": "./dist/null-worker-node.js"
    }
  },
  "sideEffects": false,
  "browser": {
    "./dist/loader-utils/lib/node/buffer.js": "./dist/loader-utils/lib/node/buffer.browser.js",
    "./dist/loader-utils/lib/node/stream.js": "./dist/loader-utils/lib/node/stream.browser.js",
    "./dist/worker-utils/lib/node/worker_threads.js": "./dist/worker-utils/lib/node/worker_threads-browser.js",
    "./dist/worker-utils/lib/process-utils/child-process-proxy.js": "./dist/worker-utils/lib/process-utils/child-process-proxy.browser.js",
    "./src/loader-utils/lib/node/buffer.ts": "./src/loader-utils/lib/node/buffer.browser.ts",
    "./src/loader-utils/lib/node/stream.ts": "./src/loader-utils/lib/node/stream.browser.ts",
    "./src/worker-utils/lib/node/worker_threads.ts": "./src/worker-utils/lib/node/worker_threads-browser.ts",
    "./src/worker-utils/lib/process-utils/child-process-proxy.ts": "./src/worker-utils/lib/process-utils/child-process-proxy.browser.ts",
    "child_process": false,
    "fs": false,
    "module": false,
    "path": false,
    "stream": false
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev && npm run build-worker && npm run build-worker-node && npm run build-worker-utils-worker && npm run build-worker-utils-worker-node",
    "build-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "ocular-bundle ./bundle.ts --env=dev --output=dist/dist.dev.js",
    "build-worker": "esbuild src/workers/null-worker.ts --outfile=dist/null-worker.js --bundle --target=esnext --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-node": "esbuild src/workers/null-worker.ts --outfile=dist/null-worker-node.js --bundle --platform=node --target=node16 --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-utils-worker": "esbuild src/worker-utils/workers/null-worker.ts --outfile=dist/worker-utils/null-worker.js --target=esnext --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-utils-worker-node": "esbuild src/worker-utils/workers/null-worker.ts --outfile=dist/worker-utils/null-worker-node.js --platform=node --target=node16 --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\""
  },
  "dependencies": {
    "@loaders.gl/schema": "5.0.0-alpha.12",
    "@loaders.gl/schema-utils": "5.0.0-alpha.12",
    "@math.gl/crs": "5.0.0-alpha.18",
    "@probe.gl/log": "^4.1.1",
    "@probe.gl/stats": "^4.1.1"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
