{
  "name": "@loaders.gl/geospatial",
  "version": "5.0.0",
  "description": "Geospatial loaders and writers for vector files, geometry encodings, and satellite orbit elements",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./kml/bundled": {
      "types": "./dist/kml/bundled.d.ts",
      "import": "./dist/kml/bundled.js",
      "require": "./dist/kml/bundled.cjs"
    },
    "./kml": {
      "types": "./dist/kml/index.d.ts",
      "import": "./dist/kml/index.js",
      "require": "./dist/kml/index.cjs"
    },
    "./shapefile/bundled": {
      "types": "./dist/shapefile/bundled.d.ts",
      "import": "./dist/shapefile/bundled.js",
      "require": "./dist/shapefile/bundled.cjs"
    },
    "./shapefile": {
      "types": "./dist/shapefile/index.d.ts",
      "import": "./dist/shapefile/index.js",
      "require": "./dist/shapefile/index.cjs"
    },
    "./gpx": {
      "types": "./dist/gpx.d.ts",
      "import": "./dist/gpx.js",
      "require": "./dist/gpx.cjs"
    },
    "./tcx": {
      "types": "./dist/tcx.d.ts",
      "import": "./dist/tcx.js",
      "require": "./dist/tcx.cjs"
    },
    "./kmz": {
      "types": "./dist/kmz.d.ts",
      "import": "./dist/kmz.js",
      "require": "./dist/kmz.cjs"
    },
    "./shp": {
      "types": "./dist/shp.d.ts",
      "import": "./dist/shp.js",
      "require": "./dist/shp.cjs"
    },
    "./dbf": {
      "types": "./dist/dbf.d.ts",
      "import": "./dist/dbf.js",
      "require": "./dist/dbf.cjs"
    },
    "./flatgeobuf/bundled": {
      "types": "./dist/flatgeobuf/bundled.d.ts",
      "import": "./dist/flatgeobuf/bundled.js",
      "require": "./dist/flatgeobuf/bundled.cjs"
    },
    "./flatgeobuf": {
      "types": "./dist/flatgeobuf/index.d.ts",
      "import": "./dist/flatgeobuf/index.js",
      "require": "./dist/flatgeobuf/index.cjs"
    },
    "./geopackage/bundled": {
      "types": "./dist/geopackage/bundled.d.ts",
      "import": "./dist/geopackage/bundled.js",
      "require": "./dist/geopackage/bundled.cjs"
    },
    "./geopackage": {
      "types": "./dist/geopackage/index.d.ts",
      "import": "./dist/geopackage/index.js",
      "require": "./dist/geopackage/index.cjs"
    },
    "./wkt": {
      "types": "./dist/wkt/index.d.ts",
      "import": "./dist/wkt/index.js",
      "require": "./dist/wkt/index.cjs"
    },
    "./wkt/bundled": {
      "types": "./dist/wkt/bundled.d.ts",
      "import": "./dist/wkt/bundled.js",
      "require": "./dist/wkt/bundled.cjs"
    },
    "./omm": {
      "types": "./dist/omm/index.d.ts",
      "import": "./dist/omm/index.js",
      "require": "./dist/omm/index.cjs"
    },
    "./omm/bundled": {
      "types": "./dist/omm/bundled.d.ts",
      "import": "./dist/omm/bundled.js",
      "require": "./dist/omm/bundled.cjs"
    },
    "./tle": {
      "types": "./dist/tle/index.d.ts",
      "import": "./dist/tle/index.js",
      "require": "./dist/tle/index.cjs"
    },
    "./tle/bundled": {
      "types": "./dist/tle/bundled.d.ts",
      "import": "./dist/tle/bundled.js",
      "require": "./dist/tle/bundled.cjs"
    },
    "./wkb": {
      "types": "./dist/wkb.d.ts",
      "import": "./dist/wkb.js",
      "require": "./dist/wkb.cjs"
    },
    "./wkt-worker.js": {
      "import": "./dist/wkt-worker.js"
    },
    "./shapefile-worker.js": {
      "import": "./dist/shapefile-worker.js"
    },
    "./gpx/bundled": {
      "types": "./dist/gpx-bundled.d.ts",
      "import": "./dist/gpx-bundled.js",
      "require": "./dist/gpx-bundled.cjs"
    },
    "./tcx/bundled": {
      "types": "./dist/tcx-bundled.d.ts",
      "import": "./dist/tcx-bundled.js",
      "require": "./dist/tcx-bundled.cjs"
    },
    "./kmz/bundled": {
      "types": "./dist/kmz-bundled.d.ts",
      "import": "./dist/kmz-bundled.js",
      "require": "./dist/kmz-bundled.cjs"
    },
    "./shp/bundled": {
      "types": "./dist/shp-bundled.d.ts",
      "import": "./dist/shp-bundled.js",
      "require": "./dist/shp-bundled.cjs"
    },
    "./dbf/bundled": {
      "types": "./dist/dbf-bundled.d.ts",
      "import": "./dist/dbf-bundled.js",
      "require": "./dist/dbf-bundled.cjs"
    },
    "./wkb/bundled": {
      "types": "./dist/wkb-bundled.d.ts",
      "import": "./dist/wkb-bundled.js",
      "require": "./dist/wkb-bundled.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "WKT-README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "pre-build": "npm run build-worker-shp-shapefile && npm run build-worker-dbf-shapefile && npm run build-worker-flatgeobuf && npm run build-worker-wkt && npm run build-format-subpaths && npm run build-worker-shapefile",
    "build-worker-shp-shapefile": "node ../../scripts/build-codec-worker.mjs src/workers/shp-worker.ts --bundle --outfile=dist/shp-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-dbf-shapefile": "node ../../scripts/build-codec-worker.mjs src/workers/dbf-worker.ts --bundle --outfile=dist/dbf-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-flatgeobuf": "node ../../scripts/build-codec-worker.mjs src/workers/flatgeobuf-worker.ts --bundle --outfile=dist/flatgeobuf-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-wkt": "esbuild src/wkt/workers/wkt-worker.ts --bundle --outfile=dist/wkt-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-format-subpaths": "node ../../scripts/build-format-subpaths.mjs",
    "build-worker-shapefile": "node ../../scripts/build-codec-worker.mjs src/workers/shapefile-worker.ts --bundle --outfile=dist/shapefile-worker.js --define:__VERSION__=\\\"$npm_package_version\\\""
  },
  "dependencies": {
    "@loaders.gl/archives": "5.0.0",
    "@loaders.gl/documents": "5.0.0",
    "@math.gl/core": "^5.0.3",
    "@math.gl/geospatial": "^5.0.3",
    "@types/sql.js": "^1.4.5",
    "apache-arrow": ">= 17.0.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0",
    "sql.js": "^1.14.1"
  },
  "browser": {
    "fs": false
  },
  "peerDependenciesMeta": {
    "sql.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "fuzzer": "^0.2.1",
    "sql.js": "1.14.1"
  },
  "keywords": [
    "loaders.gl",
    "KML",
    "KMZ",
    "GPX",
    "TCX",
    "Shapefile",
    "SHP",
    "SHX",
    "DBF",
    "CPG",
    "PRJ",
    "FlatGeobuf",
    "GeoPackage",
    "WKT",
    "WKT CRS",
    "WKB",
    "TWKB",
    "fgb",
    "gpkg",
    "OMM",
    "CCSDS",
    "TLE",
    "Two-Line Element Set",
    "Satellite orbits"
  ]
}
