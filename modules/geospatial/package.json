    "@types/sql.js": "^1.4.5",
    "apache-arrow": ">= 17.0.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0",
    "sql.js": "^1.14.1"
  },
  "browser": {
    "fs": false
  },
  "peerDependenciesMeta": {
    "sql.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "fuzzer": "^0.2.1",
    "sql.js": "1.14.1"
  },
