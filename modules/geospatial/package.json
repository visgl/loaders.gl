  "scripts": {
    "pre-build": "npm run build-worker-shp-shapefile && npm run build-worker-dbf-shapefile && npm run build-worker-flatgeobuf && npm run build-worker-wkt && npm run build-format-subpaths && npm run build-worker-shapefile",
    "build-worker-shp-shapefile": "node ../../scripts/build-codec-worker.mjs src/workers/shp-worker.ts --bundle --outfile=dist/shp-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-dbf-shapefile": "node ../../scripts/build-codec-worker.mjs src/workers/dbf-worker.ts --bundle --outfile=dist/dbf-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-flatgeobuf": "node ../../scripts/build-codec-worker.mjs src/workers/flatgeobuf-worker.ts --bundle --outfile=dist/flatgeobuf-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-wkt": "esbuild src/wkt/workers/wkt-worker.ts --bundle --outfile=dist/wkt-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-format-subpaths": "node ../../scripts/build-format-subpaths.mjs",
    "build-worker-shapefile": "node ../../scripts/build-codec-worker.mjs src/workers/shapefile-worker.ts --bundle --outfile=dist/shapefile-worker.js --define:__VERSION__=\\\"$npm_package_version\\\""
