{
  "name": "@loaders.gl/crypto",
  "version": "5.0.1",
  "description": "Checksum and cryptographic hash utilities for loaders.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loaders.gl",
    "CRC32",
    "CRC32C",
    "MD5",
    "SHA-256"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "import": "./dist/hash.js",
      "require": "./dist/hash.cjs"
    },
    "./crc32": {
      "types": "./dist/crc32.d.ts",
      "import": "./dist/crc32.js",
      "require": "./dist/crc32.cjs"
    },
    "./crc32c": {
      "types": "./dist/crc32c.d.ts",
      "import": "./dist/crc32c.js",
      "require": "./dist/crc32c.cjs"
    },
    "./md5": {
      "types": "./dist/md5.d.ts",
      "import": "./dist/md5.js",
      "require": "./dist/md5.cjs"
    },
    "./sha256": {
      "types": "./dist/sha256.d.ts",
      "import": "./dist/sha256.js",
      "require": "./dist/sha256.cjs"
    },
    "./webcrypto": {
      "types": "./dist/webcrypto.d.ts",
      "import": "./dist/webcrypto.js",
      "require": "./dist/webcrypto.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./encoding": {
      "types": "./dist/encoding.d.ts",
      "import": "./dist/encoding.js",
      "require": "./dist/encoding.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "devDependencies": {
    "crypto-js": "^4.2.0"
  },
  "browser": {
    "crypto": false,
    "sse4_crc32": false
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
