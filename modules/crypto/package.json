{
  "name": "@loaders.gl/crypto",
  "version": "5.0.0-beta.6",
  "description": "Checksum and cryptographic hash utilities for loaders.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loaders.gl",
    "CRC32",
    "CRC32C",
    "MD5",
    "SHA-256"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "ocular-bundle ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "devDependencies": {
    "crypto-js": "^4.2.0"
  },
  "browser": {
    "crypto": false,
    "sse4_crc32": false
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
