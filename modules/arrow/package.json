{
  "name": "@loaders.gl/arrow",
  "version": "5.0.0-alpha.12",
  "description": "Simple columnar table loader for the Apache Arrow format",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loader",
    "parser",
    "writer",
    "encoder",
    "geoarrow",
    "apache-arrow",
    "arrow",
    "binary columnar",
    "cloud native",
    "webgl",
    "webgpu"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./arrow-source": {
      "types": "./dist/arrow-source.d.ts",
      "import": "./dist/arrow-source.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./exports/*": {
      "types": "./dist/exports/*.d.ts",
      "import": "./dist/exports/*.js"
    },
    "./arrow-worker.js": {
      "import": "./dist/arrow-worker.js"
    },
    "./arrow-worker.mjs": {
      "import": "./dist/arrow-worker.mjs"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js",
      "require": "./dist/geometry/index.cjs"
    },
    "./arrow-loader": {
      "types": "./dist/arrow-loader.d.ts",
      "import": "./dist/arrow-loader.js"
    },
    "./geoarrow-loader": {
      "types": "./dist/geoarrow-loader.d.ts",
      "import": "./dist/geoarrow-loader.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "browser": {
    "fs": false
  },
  "scripts": {
    "pre-build": "npm run build-worker && npm run build-module-worker && npm run build-bundle && npm run build-bundle-dev && npm run build-triangulation-worker && npm run build-triangulation-worker-node",
    "build-module-worker": "node ../../scripts/build-codec-worker.mjs src/workers/arrow-worker.ts --bundle --outfile=dist/arrow-worker.mjs --format=esm --platform=browser --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js",
    "build-triangulation-worker": "node ../../scripts/build-codec-worker.mjs src/workers/triangulation-worker.ts --bundle --outfile=dist/triangulation-worker.js  --platform=browser --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-triangulation-worker-node": "node ../../scripts/build-codec-worker.mjs src/workers/triangulation-worker-node.ts --bundle --outfile=dist/triangulation-worker-node.js --platform=node --target=node16 --format=esm --tree-shaking=false --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "pre-build2": "cp fixed-package.json ../../node_modules/apache-arrow/package.json && npm run build-bundle && npm run build-worker",
    "build-worker": "node ../../scripts/build-codec-worker.mjs src/workers/arrow-worker.ts --bundle --outfile=dist/arrow-worker.js  --platform=browser --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker2": "node ../../scripts/build-codec-worker.mjs src/workers/arrow-worker.ts --bundle --outfile=dist/arrow-worker.js --platform=browser --external:{stream}"
  },
  "dependencies": {
    "@loaders.gl/arrow-geometry": "5.0.0-alpha.12",
    "@loaders.gl/compression": "5.0.0-alpha.12",
    "@loaders.gl/loader-utils": "5.0.0-alpha.12",
    "@loaders.gl/schema": "5.0.0-alpha.12",
    "@loaders.gl/schema-utils": "5.0.0-alpha.12",
    "@loaders.gl/wkt": "5.0.0-alpha.12",
    "@loaders.gl/worker-utils": "5.0.0-alpha.12",
    "@math.gl/wkb": "5.0.0-alpha.16",
    "apache-arrow": ">= 17.0.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3",
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ],
      "geometry": [
        "dist/geometry/index.d.ts"
      ]
    }
  }
}
