{
  "name": "@loaders.gl/gltf",
  "version": "5.0.0-alpha.13",
  "description": "Framework-independent loader for the glTF format",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "mesh",
    "point cloud",
    "GLB",
    "glTF"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./mesh-arrow": {
      "types": "./dist/mesh-arrow.d.ts",
      "import": "./dist/mesh-arrow.js"
    },
    "./gltf.schema.json": "./dist/gltf.schema.json",
    "./gltf-1.schema.json": "./dist/gltf-1.schema.json",
    "./gltf-2.schema.json": "./dist/gltf-2.schema.json",
    "./gltf-2.1.schema.json": "./dist/gltf-2.1.schema.json",
    "./gltf-all.schema.json": "./dist/gltf-all.schema.json",
    "./schemas/*": "./dist/schemas/*"
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run copy-libs && npm run build-cjs && npm run generate-json-schema && npm run build-bundle && npm run build-bundle-dev",
    "generate-json-schema": "node scripts/generate-json-schema.mjs",
    "update-official-schemas": "node scripts/update-official-schemas.mjs",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js",
    "copy-libs": "mkdir -p dist/libs && cp -rf src/libs/* dist/libs",
    "build-cjs": "node ../../node_modules/@vis.gl/dev-tools/dist/build-cjs.js"
  },
  "dependencies": {
    "@loaders.gl/draco": "5.0.0-alpha.13",
    "@loaders.gl/images": "5.0.0-alpha.13",
    "@loaders.gl/textures": "5.0.0-alpha.13",
    "@math.gl/core": "5.0.0-alpha.19",
    "@math.gl/geometry": "5.0.0-alpha.19",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3",
  "devDependencies": {
    "meshoptimizer": "1.3.0"
  }
}
