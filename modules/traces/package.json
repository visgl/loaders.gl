{
  "name": "@loaders.gl/traces",
  "version": "5.0.0-alpha.2",
  "description": "Trace format parsers for Chrome Trace, Perfetto Trace, OpenTelemetry OTLP, Jaeger, and Zipkin",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "trace",
    "chrome trace",
    "perfetto",
    "opentelemetry",
    "otlp",
    "jaeger",
    "zipkin",
    "parser",
    "loader",
    "writer"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chrome-trace-loader": {
      "types": "./dist/chrome-trace-loader.d.ts",
      "import": "./dist/chrome-trace-loader.js"
    },
    "./perfetto-trace-loader": {
      "types": "./dist/perfetto-trace-loader.d.ts",
      "import": "./dist/perfetto-trace-loader.js"
    },
    "./otlp-trace-loader": {
      "types": "./dist/otlp-trace-loader.d.ts",
      "import": "./dist/otlp-trace-loader.js"
    },
    "./otlp-trace-json-loader": {
      "types": "./dist/otlp-trace-json-loader.d.ts",
      "import": "./dist/otlp-trace-json-loader.js"
    },
    "./jaeger-trace-loader": {
      "types": "./dist/jaeger-trace-loader.d.ts",
      "import": "./dist/jaeger-trace-loader.js"
    },
    "./zipkin-trace-loader": {
      "types": "./dist/zipkin-trace-loader.d.ts",
      "import": "./dist/zipkin-trace-loader.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "echo \"Nothing to build in @loaders.gl/traces\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@loaders.gl/json": "5.0.0-alpha.2",
    "@loaders.gl/loader-utils": "5.0.0-alpha.2",
    "apache-arrow": ">= 17.0.0",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "f1a6da2c65e4ea06b59c61d1884819b6be577fe3"
}
