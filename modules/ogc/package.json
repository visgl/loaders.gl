{
  "name": "@loaders.gl/ogc",
  "version": "5.0.1",
  "description": "OGC web service clients and STAC catalog sources",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "ogc",
    "wms",
    "wfs",
    "wmts",
    "wcs",
    "csw",
    "stac",
    "geospatial",
    "loaders.gl",
    "GML",
    "OGC API",
    "STAC API",
    "XML",
    "JSON",
    "GeoJSON"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wms": {
      "types": "./dist/wms/metadata-entry.d.ts",
      "import": "./dist/wms/metadata-entry.js",
      "require": "./dist/wms/metadata-entry.cjs"
    },
    "./wms/bundled": {
      "types": "./dist/wms/bundled.d.ts",
      "import": "./dist/wms/bundled.js",
      "require": "./dist/wms/bundled.cjs"
    },
    "./gml-loader": {
      "types": "./dist/wms/gml-loader.d.ts",
      "import": "./dist/wms/gml-loader.js",
      "require": "./dist/wms/gml-loader.cjs"
    },
    "./wmts-capabilities-loader-with-parser": {
      "types": "./dist/wms/wmts-capabilities-loader-with-parser.d.ts",
      "import": "./dist/wms/wmts-capabilities-loader-with-parser.js",
      "require": "./dist/wms/wmts-capabilities-loader-with-parser.cjs"
    },
    "./stac": {
      "types": "./dist/stac/metadata-entry.d.ts",
      "import": "./dist/stac/metadata-entry.js",
      "require": "./dist/stac/metadata-entry.cjs"
    },
    "./stac-loader": {
      "types": "./dist/stac/stac-loader.d.ts",
      "import": "./dist/stac/stac-loader.js",
      "require": "./dist/stac/stac-loader.cjs"
    },
    "./csw": {
      "types": "./dist/csw/metadata-entry.d.ts",
      "import": "./dist/csw/metadata-entry.js",
      "require": "./dist/csw/metadata-entry.cjs"
    },
    "./wmts": {
      "types": "./dist/wmts/metadata-entry.d.ts",
      "import": "./dist/wmts/metadata-entry.js",
      "require": "./dist/wmts/metadata-entry.cjs"
    },
    "./wfs": {
      "types": "./dist/wfs/metadata-entry.d.ts",
      "import": "./dist/wfs/metadata-entry.js",
      "require": "./dist/wfs/metadata-entry.cjs"
    },
    "./gml": {
      "types": "./dist/gml/metadata-entry.d.ts",
      "import": "./dist/gml/metadata-entry.js",
      "require": "./dist/gml/metadata-entry.cjs"
    },
    "./stac/bundled": {
      "types": "./dist/stac/bundled.d.ts",
      "import": "./dist/stac/bundled.js",
      "require": "./dist/stac/bundled.cjs"
    },
    "./csw/bundled": {
      "types": "./dist/csw/bundled.d.ts",
      "import": "./dist/csw/bundled.js",
      "require": "./dist/csw/bundled.cjs"
    },
    "./wmts/bundled": {
      "types": "./dist/wmts/bundled.d.ts",
      "import": "./dist/wmts/bundled.js",
      "require": "./dist/wmts/bundled.cjs"
    },
    "./wfs/bundled": {
      "types": "./dist/wfs/bundled.d.ts",
      "import": "./dist/wfs/bundled.js",
      "require": "./dist/wfs/bundled.cjs"
    },
    "./gml/bundled": {
      "types": "./dist/gml/bundled.d.ts",
      "import": "./dist/gml/bundled.js",
      "require": "./dist/gml/bundled.cjs"
    },
    "./wms/api": {
      "types": "./dist/wms/api.d.ts",
      "import": "./dist/wms/api.js",
      "require": "./dist/wms/api.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0",
    "apache-arrow": ">= 17.0.0"
  },
  "dependencies": {
    "@loaders.gl/documents": "5.0.1",
    "@loaders.gl/images": "5.0.1",
    "@loaders.gl/raster": "5.0.1",
    "@math.gl/geospatial": "^5.0.4",
    "lerc": "^4.2.0"
  },
  "browser": {
    "fs": false,
    "path": false
  }
}
