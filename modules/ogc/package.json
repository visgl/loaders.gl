{
  "name": "@loaders.gl/ogc",
  "version": "5.0.0-beta.1",
  "description": "OGC web service clients and STAC catalog sources",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "ogc",
    "wms",
    "wfs",
    "wmts",
    "wcs",
    "csw",
    "stac",
    "geospatial",
    "loaders.gl",
    "GML",
    "OGC API",
    "STAC API",
    "XML",
    "JSON",
    "GeoJSON"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wms": {
      "types": "./dist/wms/index.d.ts",
      "import": "./dist/wms/index.js",
      "require": "./dist/wms/index.cjs"
    },
    "./wms/unbundled": {
      "types": "./dist/wms/unbundled.d.ts",
      "import": "./dist/wms/unbundled.js",
      "require": "./dist/wms/unbundled.cjs"
    },
    "./wms/bundled": {
      "types": "./dist/wms/bundled.d.ts",
      "import": "./dist/wms/bundled.js",
      "require": "./dist/wms/bundled.cjs"
    },
    "./wms/gml-loader": {
      "types": "./dist/wms/gml-loader.d.ts",
      "import": "./dist/wms/gml-loader.js",
      "require": "./dist/wms/gml-loader.cjs"
    },
    "./wms/wmts-capabilities-loader-with-parser": {
      "types": "./dist/wms/wmts-capabilities-loader-with-parser.d.ts",
      "import": "./dist/wms/wmts-capabilities-loader-with-parser.js",
      "require": "./dist/wms/wmts-capabilities-loader-with-parser.cjs"
    },
    "./stac": {
      "types": "./dist/stac/index.d.ts",
      "import": "./dist/stac/index.js",
      "require": "./dist/stac/index.cjs"
    },
    "./stac/stac-source": {
      "types": "./dist/stac/stac-source.d.ts",
      "import": "./dist/stac/stac-source.js",
      "require": "./dist/stac/stac-source.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "dependencies": {
    "@loaders.gl/documents": "5.0.0-beta.1",
    "@loaders.gl/images": "5.0.0-beta.1",
    "@loaders.gl/raster": "5.0.0-beta.1",
    "@math.gl/geospatial": "5.0.0-beta.1",
    "lerc": "^4.2.0"
  },
  "browser": {
    "fs": false,
    "path": false
  }
}
