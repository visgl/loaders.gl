    },
    "./csv/api": {
      "types": "./dist/csv/api.d.ts",
      "import": "./dist/csv/api.js",
      "require": "./dist/csv/api.cjs"
    },
    "./json/api": {
      "types": "./dist/json/api.d.ts",
      "import": "./dist/json/api.js",
      "require": "./dist/json/api.cjs"
    },
    "./orc/api": {
      "types": "./dist/orc/api.d.ts",
      "import": "./dist/orc/api.js",
      "require": "./dist/orc/api.cjs"
    },
    "./lance/api": {
      "types": "./dist/lance-api.d.ts",
      "import": "./dist/lance-api.js",
      "require": "./dist/lance-api.cjs"
    }
