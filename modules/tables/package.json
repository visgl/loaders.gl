  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "pre-build": "npm run build-worker-csv && npm run build-worker-node-csv && npm run build-triangulation-worker-arrow && npm run build-triangulation-worker-node-arrow && npm run build-worker-arrow && npm run build-worker-json && npm run build-worker-parquet && npm run build-worker-node-parquet && npm run build-source-worker-parquet && npm run build-worker-json-tables && npm run build-worker-node-json-tables && npm run build-worker-geoarrow && npm run build-worker-node-arrow && npm run build-worker-node-geoarrow",
    "build-worker-csv": "node ../../scripts/build-codec-worker.mjs src/workers/csv-worker.ts --bundle --outfile=dist/csv-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-node-csv": "node ../../scripts/build-codec-worker.mjs src/workers/csv-worker-node.ts --outfile=dist/csv-worker-node.js --platform=node --target=node16 --bundle --sourcemap --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-triangulation-worker-arrow": "node ../../scripts/build-codec-worker.mjs src/arrow/workers/triangulation-worker.ts --bundle --outfile=dist/triangulation-worker.js  --platform=browser --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-triangulation-worker-node-arrow": "node ../../scripts/build-codec-worker.mjs src/arrow/workers/triangulation-worker-node.ts --bundle --outfile=dist/triangulation-worker-node.js --platform=node --target=node16 --format=esm --tree-shaking=false --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-arrow": "node ../../scripts/build-codec-worker.mjs src/arrow/workers/arrow-worker.ts --bundle --outfile=dist/arrow-worker.js  --platform=browser --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-json": "node ../../scripts/build-codec-worker.mjs src/json/workers/geojson-worker.ts --bundle --outfile=dist/geojson-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-parquet": "node ../../scripts/build-codec-worker.mjs src/parquet/workers/parquet-worker.ts --outfile=dist/parquet-worker.js --target=esnext --platform=browser --bundle --sourcemap --inject:src/parquet/polyfills/process.ts --banner:js=var\\ global=globalThis\\; --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-node-parquet": "node ../../scripts/build-codec-worker.mjs src/parquet/workers/parquet-worker.ts --outfile=dist/parquet-worker-node.cjs --platform=node --target=node16 --bundle --sourcemap --tree-shaking=false --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-source-worker-parquet": "node ../../scripts/build-codec-worker.mjs src/parquet/workers/parquet-source-worker.ts --outfile=dist/parquet-source-worker.js --target=esnext --platform=browser --bundle --sourcemap --inject:src/parquet/polyfills/process.ts --banner:js=var\\ global=globalThis\\; --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-json-tables": "node ../../scripts/build-codec-worker.mjs src/json/workers/json-worker.ts --bundle --outfile=dist/json-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-node-json-tables": "node ../../scripts/build-codec-worker.mjs src/json/workers/json-worker.ts --outfile=dist/json-worker-node.cjs --platform=node --target=node16 --bundle --sourcemap --tree-shaking=false --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-geoarrow": "node ../../scripts/build-codec-worker.mjs src/arrow/workers/geoarrow-worker.ts --bundle --outfile=dist/geoarrow-worker.js  --platform=browser --external:{stream} --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-node-arrow": "node ../../scripts/build-codec-worker.mjs src/arrow/workers/arrow-worker.ts --outfile=dist/arrow-worker-node.cjs --platform=node --target=node16 --bundle --sourcemap --tree-shaking=false --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-node-geoarrow": "node ../../scripts/build-codec-worker.mjs src/arrow/workers/geoarrow-worker.ts --outfile=dist/geoarrow-worker-node.cjs --platform=node --target=node16 --bundle --sourcemap --tree-shaking=false --define:__VERSION__=\\\"$npm_package_version\\\""
  },
  "dependencies": {
    "@loaders.gl/compression": "5.0.0",
    "@loaders.gl/documents": "5.0.0",
    "@math.gl/core": "^5.0.4",
    "@math.gl/geospatial": "^5.0.4",
    "apache-arrow": ">= 17.0.0",
    "probe.gl": "^5.0.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "browser": {
    "child_process": false,
    "events": false,
    "fs": false,
    "net": false,
    "stream": false,
    "tls": false,
    "util": false
  },
  "keywords": [
    "loaders.gl",
    "Arrow",
    "Feather",
    "GeoArrow",
    "Avro",
    "AVSC",
    "BSON",
    "CSV",
    "TSV",
    "DSV",
    "JSON",
    "GeoJSON",
    "NDJSON",
    "JSONL",
    "NDGeoJSON",
    "GeoJSONL",
    "LDGeoJSON",
    "Lance",
    "ORC",
    "Parquet",
    "GeoParquet",
    "Delta Lake",
    "checkpoint.parquet"
  ]
}
