      "require": "./dist/csv/bundled-entry.cjs"
    },
    "./csv": {
      "types": "./dist/csv/metadata-entry.d.ts",
      "import": "./dist/csv/metadata-entry.js",
      "require": "./dist/csv/metadata-entry.cjs"
    },
    "./csv-worker.js": {
      "import": "./dist/csv-worker.js"
    },
    "./csv-worker-node.js": {
      "import": "./dist/csv-worker-node.js"
    },
    "./avro": {
      "types": "./dist/avro/metadata-entry.d.ts",
      "import": "./dist/avro/metadata-entry.js",
      "require": "./dist/avro/metadata-entry.cjs"
    },
    "./arrow/triangulate-on-worker": {
      "types": "./dist/arrow/triangulate-on-worker.d.ts",
      "import": "./dist/arrow/triangulate-on-worker.js"
    },
    "./arrow/types": {
      "types": "./dist/arrow/types.d.ts",
      "import": "./dist/arrow/types.js",
      "require": "./dist/arrow/types.cjs"
    },
    "./arrow/bundled": {
      "types": "./dist/arrow/bundled-entry.d.ts",
      "import": "./dist/arrow/bundled-entry.js",
      "require": "./dist/arrow/bundled-entry.cjs"
    },
    "./arrow": {
      "types": "./dist/arrow/metadata-entry.d.ts",
      "import": "./dist/arrow/metadata-entry.js",
      "require": "./dist/arrow/metadata-entry.cjs"
    },
    "./arrow/exports/*": {
      "types": "./dist/arrow/exports/*.d.ts",
      "import": "./dist/arrow/exports/*.js"
    },
    "./arrow/arrow-worker.js": {
      "import": "./dist/arrow-worker.js"
    },
    "./arrow/geometry": {
      "types": "./dist/arrow/geometry/index.d.ts",
      "import": "./dist/arrow/geometry/index.js",
      "require": "./dist/arrow/geometry/index.cjs"
    },
    "./json/bundled": {
      "types": "./dist/json/bundled-entry.d.ts",
      "import": "./dist/json/bundled-entry.js",
      "require": "./dist/json/bundled-entry.cjs"
    },
    "./json": {
      "types": "./dist/json/metadata-entry.d.ts",
      "import": "./dist/json/metadata-entry.js",
      "require": "./dist/json/metadata-entry.cjs"
    },
    "./json/geojson-worker.js": {
      "import": "./dist/geojson-worker.js"
    },
    "./lance": {
      "types": "./dist/lance/metadata-entry.d.ts",
      "import": "./dist/lance/metadata-entry.js",
      "require": "./dist/lance/metadata-entry.cjs"
    },
    "./orc/bundled": {
      "types": "./dist/orc/bundled-entry.d.ts",
      "import": "./dist/orc/bundled-entry.js",
      "require": "./dist/orc/bundled-entry.cjs"
    },
    "./orc": {
      "types": "./dist/orc/metadata-entry.d.ts",
      "import": "./dist/orc/metadata-entry.js",
      "require": "./dist/orc/metadata-entry.cjs"
    },
    "./parquet/bundled": {
      "types": "./dist/parquet/bundled-entry.d.ts",
      "import": "./dist/parquet/bundled-entry.js",
      "require": "./dist/parquet/bundled-entry.cjs"
    },
    "./parquet": {
      "types": "./dist/parquet/index.d.ts",
      "import": "./dist/parquet/index.js",
      "require": "./dist/parquet/index.cjs"
    },
    "./parquet/parquet-worker.js": {
      "import": "./dist/parquet-worker.js"
    },
    "./parquet/parquet-worker-node.cjs": {
      "import": "./dist/parquet-worker-node.cjs",
      "require": "./dist/parquet-worker-node.cjs"
    },
    "./parquet/parquet-source-worker.js": {
      "import": "./dist/parquet-source-worker.js"
    },
    "./triangulation-worker.js": {
      "import": "./dist/triangulation-worker.js"
    },
    "./triangulation-worker-node.js": {
      "import": "./dist/triangulation-worker-node.js"
    },
    "./json-worker.js": {
      "import": "./dist/json-worker.js"
    },
    "./json-worker-node.cjs": {
      "import": "./dist/json-worker-node.cjs",
      "require": "./dist/json-worker-node.cjs"
    },
    "./arrow-worker-node.cjs": {
      "import": "./dist/arrow-worker-node.cjs",
      "require": "./dist/arrow-worker-node.cjs"
    },
    "./geoarrow-worker-node.cjs": {
      "import": "./dist/geoarrow-worker-node.cjs",
      "require": "./dist/geoarrow-worker-node.cjs"
    },
    "./geojson": {
      "types": "./dist/geojson/metadata-entry.d.ts",
      "import": "./dist/geojson/metadata-entry.js",
      "require": "./dist/geojson/metadata-entry.cjs"
    },
    "./geoarrow": {
      "types": "./dist/geoarrow/metadata-entry.d.ts",
      "import": "./dist/geoarrow/metadata-entry.js",
      "require": "./dist/geoarrow/metadata-entry.cjs"
    },
    "./delta/bundled": {
      "types": "./dist/delta-bundled.d.ts",
      "import": "./dist/delta-bundled.js",
      "require": "./dist/delta-bundled.cjs"
    },
    "./avro/bundled": {
      "types": "./dist/avro-bundled-entry.d.ts",
      "import": "./dist/avro-bundled-entry.js",
      "require": "./dist/avro-bundled-entry.cjs"
    },
    "./lance/bundled": {
      "types": "./dist/lance-bundled-entry.d.ts",
      "import": "./dist/lance-bundled-entry.js",
      "require": "./dist/lance-bundled-entry.cjs"
    },
    "./geojson/bundled": {
      "types": "./dist/geojson-bundled.d.ts",
      "import": "./dist/geojson-bundled.js",
