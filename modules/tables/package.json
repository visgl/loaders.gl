{
  "name": "@loaders.gl/tables",
  "version": "5.0.0",
  "description": "Tabular data loaders, writers, and sources for columnar and row-oriented formats",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./iceberg": {
      "types": "./dist/iceberg/index.d.ts",
      "import": "./dist/iceberg/index.js",
      "require": "./dist/iceberg/index.cjs"
    },
    "./delta": {
      "types": "./dist/delta/metadata-entry.d.ts",
