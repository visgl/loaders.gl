      "require": "./dist/delta/metadata-entry.cjs"
    },
    "./hudi": {
      "types": "./dist/hudi/index.d.ts",
      "import": "./dist/hudi/index.js",
      "require": "./dist/hudi/index.cjs"
    },
    "./csv/bundled": {
