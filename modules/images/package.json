{
  "name": "@loaders.gl/images",
  "version": "5.0.0-rc.1",
  "description": "Image, compressed texture, and video loaders with optional Node.js image codecs",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loaders.gl",
    "PNG",
    "JPEG",
    "JPG",
    "GIF",
    "WebP",
    "BMP",
    "ICO",
    "SVG",
    "AVIF"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js",
      "require": "./dist/bundled.cjs"
    },
    "./basis-worker.js": {
      "import": "./dist/basis-worker.js"
    },
    "./basis-worker-node.js": {
      "import": "./dist/basis-worker-node.cjs",
      "require": "./dist/basis-worker-node.cjs"
    },
    "./compressed-texture-worker.js": {
      "import": "./dist/compressed-texture-worker.js"
    },
    "./crunch-worker.js": {
      "import": "./dist/crunch-worker.js"
    },
    "./ktx2-basis-writer-worker.js": {
      "import": "./dist/ktx2-basis-writer-worker.js"
    },
    "./ktx2-basis-writer-worker-node.js": {
      "import": "./dist/ktx2-basis-writer-worker-node.cjs",
      "require": "./dist/ktx2-basis-writer-worker-node.cjs"
    },
    "./texture-manifest.schema.json": "./dist/texture-manifest.schema.json",
    "./basis-worker-node.cjs": {
      "require": "./dist/basis-worker-node.cjs",
      "default": "./dist/basis-worker-node.cjs"
    },
    "./ktx2-basis-writer-worker-node.cjs": {
      "require": "./dist/ktx2-basis-writer-worker-node.cjs",
      "default": "./dist/ktx2-basis-writer-worker-node.cjs"
    },
    "./gl-extensions": {
      "types": "./dist/gl-extensions.d.ts",
      "import": "./dist/gl-extensions.js",
      "require": "./dist/gl-extensions.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./color-lut": {
      "types": "./dist/color-lut.d.ts",
      "import": "./dist/color-lut.js",
      "require": "./dist/color-lut.cjs"
    },
    "./texture": {
      "types": "./dist/texture.d.ts",
      "import": "./dist/texture.js",
      "require": "./dist/texture.cjs"
    },
    "./basis": {
      "types": "./dist/basis.d.ts",
      "import": "./dist/basis.js",
      "require": "./dist/basis.cjs"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "require": "./dist/image.cjs"
    },
    "./video": {
      "types": "./dist/video.d.ts",
      "import": "./dist/video.js",
      "require": "./dist/video.cjs"
    },
    "./radiance-hdr": {
      "types": "./dist/radiance-hdr.d.ts",
      "import": "./dist/radiance-hdr.js",
      "require": "./dist/radiance-hdr.cjs"
    },
    "./crunch": {
      "types": "./dist/crunch.d.ts",
      "import": "./dist/crunch.js",
      "require": "./dist/crunch.cjs"
    },
    "./ies": {
      "types": "./dist/ies.d.ts",
      "import": "./dist/ies.js",
      "require": "./dist/ies.cjs"
    },
    "./exr": {
      "types": "./dist/exr.d.ts",
      "import": "./dist/exr.js",
      "require": "./dist/exr.cjs"
    },
    "./color-lut/bundled": {
      "types": "./dist/color-lut-bundled.d.ts",
      "import": "./dist/color-lut-bundled.js",
      "require": "./dist/color-lut-bundled.cjs"
    },
    "./texture/bundled": {
      "types": "./dist/texture-bundled.d.ts",
      "import": "./dist/texture-bundled.js",
      "require": "./dist/texture-bundled.cjs"
    },
    "./basis/bundled": {
      "types": "./dist/basis-bundled.d.ts",
      "import": "./dist/basis-bundled.js",
      "require": "./dist/basis-bundled.cjs"
    },
    "./image/bundled": {
      "types": "./dist/image-bundled.d.ts",
      "import": "./dist/image-bundled.js",
      "require": "./dist/image-bundled.cjs"
    },
    "./video/bundled": {
      "types": "./dist/video-bundled.d.ts",
      "import": "./dist/video-bundled.js",
      "require": "./dist/video-bundled.cjs"
    },
    "./radiance-hdr/bundled": {
      "types": "./dist/radiance-hdr-bundled.d.ts",
      "import": "./dist/radiance-hdr-bundled.js",
      "require": "./dist/radiance-hdr-bundled.cjs"
    },
    "./ies/bundled": {
      "types": "./dist/ies-bundled.d.ts",
      "import": "./dist/ies-bundled.js",
      "require": "./dist/ies-bundled.cjs"
    },
    "./exr/bundled": {
      "types": "./dist/exr-bundled.d.ts",
      "import": "./dist/exr-bundled.js",
      "require": "./dist/exr-bundled.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "pre-build": "npm run generate-json-schema && npm run copy-libs && npm run build-bundle && npm run build-bundle-dev && npm run build-workers && npm run build-metadata",
    "build-bundle": "ocular-bundle ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "ocular-bundle ./bundle.ts --env=dev --output=dist/dist.dev.js",
    "generate-json-schema": "node ../../scripts/generate-json-schema.mjs --schema ./dist/texture-manifest-schema.js --export CompositeImageManifestSchema --output ./dist/texture-manifest.schema.json --id https://unpkg.com/@loaders.gl/images/texture-manifest.schema.json --title 'loaders.gl composite image texture manifest'",
    "copy-libs": "mkdir -p ./dist/libs && cp -rf ./src/libs/. ./dist/libs && node ../../scripts/build-library-modules.mjs images",
    "build-workers": "npm run build-basis-worker && npm run build-basis-worker-node && npm run build-compressed-texture-worker && npm run build-crunch-worker && npm run build-ktx2-basis-writer-worker && npm run build-ktx2-basis-writer-worker-node",
    "build-basis-worker": "esbuild src/workers/basis-worker.ts --outfile=dist/basis-worker.js --target=esnext --bundle --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-basis-worker-node": "esbuild src/workers/basis-worker-node.ts --outfile=dist/basis-worker-node.cjs --target=node16  --platform=node --bundle --define:__VERSION__=\\\"$npm_package_version\\\" --external:sharp",
    "build-ktx2-basis-writer-worker": "esbuild src/workers/ktx2-basis-writer-worker.ts --outfile=dist/ktx2-basis-writer-worker.js --target=esnext --bundle --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-ktx2-basis-writer-worker-node": "esbuild src/workers/ktx2-basis-writer-worker-node.ts --outfile=dist/ktx2-basis-writer-worker-node.cjs --target=node16  --platform=node --bundle --define:__VERSION__=\\\"$npm_package_version\\\" --external:sharp",
    "build-compressed-texture-worker": "esbuild src/workers/compressed-texture-worker.ts --target=esnext --bundle --outfile=dist/compressed-texture-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-crunch-worker": "esbuild src/workers/crunch-worker.ts --outfile=dist/crunch-worker.js --target=esnext --bundle --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-metadata": "node ../../scripts/build-images-metadata.mjs"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0",
    "texture-compressor": "^1.0.2"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3",
  "dependencies": {
    "@math.gl/core": "5.0.0-rc.1",
    "zod": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "texture-compressor": {
      "optional": true
    }
  }
}
