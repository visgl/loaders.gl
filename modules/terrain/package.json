{
  "name": "@loaders.gl/terrain",
  "version": "5.0.0-alpha.12",
  "description": "Framework-independent loader for terrain raster formats",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "mesh",
    "point cloud",
    "OBJ"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./heightmap": {
      "types": "./dist/heightmap.d.ts",
      "import": "./dist/heightmap.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./terrain-worker.js": {
      "import": "./dist/terrain-worker.js"
    },
    "./quantized-mesh-worker.js": {
      "import": "./dist/quantized-mesh-worker.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run copy-libs && npm run build-cjs && npm run build-worker && npm run build-worker2 && npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js",
    "build-worker": "node ../../scripts/build-codec-worker.mjs src/workers/terrain-worker.ts --bundle --outfile=dist/terrain-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker2": "node ../../scripts/build-codec-worker.mjs src/workers/quantized-mesh-worker.ts --bundle --outfile=dist/quantized-mesh-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "copy-libs": "mkdir -p dist/libs && cp -rf src/libs/* dist/libs",
    "build-cjs": "node ../../node_modules/@vis.gl/dev-tools/dist/build-cjs.js"
  },
  "dependencies": {
    "@loaders.gl/arrow": "5.0.0-alpha.12",
    "@loaders.gl/images": "5.0.0-alpha.12",
    "@loaders.gl/loader-utils": "5.0.0-alpha.12",
    "@loaders.gl/schema": "5.0.0-alpha.12",
    "@loaders.gl/schema-utils": "5.0.0-alpha.12"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3",
  "devDependencies": {
    "@mapbox/martini": "0.2.0"
  }
}
