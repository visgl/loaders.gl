{
  "name": "@loaders.gl/arcgis",
  "version": "5.0.0-beta.2",
  "description": "ArcGIS REST sources for feature, map, imagery, vector tile, and scene services",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "ArcGIS",
    "services",
    "FeatureServer",
    "ImageServer",
    "MapServer",
    "geospatial",
    "loader",
    "loaders.gl",
    "VectorTileServer",
    "SceneServer",
    "PBF",
    "JSON",
    "GeoJSON"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./arcgis-feature-server-source-loader": {
      "types": "./dist/arcgis-feature-server-source-loader.d.ts",
      "import": "./dist/arcgis-feature-server-source-loader.js"
    },
    "./arcgis-image-server-source-loader": {
      "types": "./dist/arcgis-image-server-source-loader.d.ts",
      "import": "./dist/arcgis-image-server-source-loader.js"
    },
    "./arcgis-image-tile-source-loader": {
      "types": "./dist/arcgis-image-tile-source-loader.d.ts",
      "import": "./dist/arcgis-image-tile-source-loader.js"
    },
    "./arcgis-map-tile-source-loader": {
      "types": "./dist/arcgis-map-tile-source-loader.d.ts",
      "import": "./dist/arcgis-map-tile-source-loader.js"
    },
    "./arcgis-scene-server-source-loader": {
      "types": "./dist/arcgis-scene-server-source-loader.d.ts",
      "import": "./dist/arcgis-scene-server-source-loader.js"
    },
    "./arcgis-vector-tile-server-source-loader": {
      "types": "./dist/arcgis-vector-tile-server-source-loader.d.ts",
      "import": "./dist/arcgis-vector-tile-server-source-loader.js"
    },
    "./authentication": {
      "types": "./dist/authentication.d.ts",
      "import": "./dist/authentication.js"
    },
    "./discovery": {
      "types": "./dist/arcgis/arcgis-capability-graph.d.ts",
      "import": "./dist/arcgis/arcgis-capability-graph.js"
    },
    "./scene-aggregation": {
      "types": "./dist/arcgis/arcgis-scene-aggregation.d.ts",
      "import": "./dist/arcgis/arcgis-scene-aggregation.js"
    },
    "./items": {
      "types": "./dist/arcgis-items.d.ts",
      "import": "./dist/arcgis-items.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@loaders.gl/images": "5.0.0-beta.2",
    "@loaders.gl/raster": "5.0.0-beta.2",
    "@loaders.gl/tiles": "5.0.0-beta.2",
    "@loaders.gl/tiles-3d": "5.0.0-beta.2",
    "lerc": "^4.2.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
