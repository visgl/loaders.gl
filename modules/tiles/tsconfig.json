{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "src/mlt/libs/**/*.cjs"
  ],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../tables"
    },
    {
      "path": "../arrow-geometry"
    },
    {
      "path": "../compression"
    },
    {
      "path": "../images"
    },
    {
      "path": "../tiles-3d"
    }
  ]
}
