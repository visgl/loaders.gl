{
  "name": "@loaders.gl/splats",
  "version": "5.0.1",
  "description": "Gaussian splat loaders for SPLAT, KSPLAT, SPZ, and RAD",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "point cloud",
    "gaussian splats",
    "splat",
    "ksplat",
    "loaders.gl",
    "SPZ",
    "RAD"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./splat-loader": {
      "types": "./dist/splat-loader.d.ts",
      "import": "./dist/splat-loader.js"
    },
    "./ksplat-loader": {
      "types": "./dist/ksplat-loader.d.ts",
      "import": "./dist/ksplat-loader.js"
    },
    "./spz-loader": {
      "types": "./dist/spz-loader.d.ts",
      "import": "./dist/spz-loader.js"
    },
    "./rad-loader": {
      "types": "./dist/rad-loader.d.ts",
      "import": "./dist/rad-loader.js"
    },
    "./rad-source-loader": {
      "types": "./dist/rad-source-loader.d.ts",
      "import": "./dist/rad-source-loader.js"
    },
    "./rad-zod-schema": {
      "types": "./dist/rad-zod-schema.d.ts",
      "import": "./dist/rad-zod-schema.js",
      "require": "./dist/rad-zod-schema.cjs"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./rad-metadata.schema.json": "./dist/rad-metadata.schema.json",
    "./radc-metadata.schema.json": "./dist/radc-metadata.schema.json",
    "./rad": {
      "types": "./dist/rad/metadata-entry.d.ts",
      "import": "./dist/rad/metadata-entry.js",
      "require": "./dist/rad/metadata-entry.cjs"
    },
    "./splat": {
      "types": "./dist/splat/metadata-entry.d.ts",
      "import": "./dist/splat/metadata-entry.js",
      "require": "./dist/splat/metadata-entry.cjs"
    },
    "./ksplat": {
      "types": "./dist/ksplat/metadata-entry.d.ts",
      "import": "./dist/ksplat/metadata-entry.js",
      "require": "./dist/ksplat/metadata-entry.cjs"
    },
    "./spz": {
      "types": "./dist/spz/metadata-entry.d.ts",
      "import": "./dist/spz/metadata-entry.js",
      "require": "./dist/spz/metadata-entry.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./rad/bundled": {
      "types": "./dist/rad/bundled-entry.d.ts",
      "import": "./dist/rad/bundled-entry.js",
      "require": "./dist/rad/bundled-entry.cjs"
    },
    "./splat/bundled": {
      "types": "./dist/splat/bundled.d.ts",
      "import": "./dist/splat/bundled.js",
      "require": "./dist/splat/bundled.cjs"
    },
    "./ksplat/bundled": {
      "types": "./dist/ksplat/bundled.d.ts",
      "import": "./dist/ksplat/bundled.js",
      "require": "./dist/ksplat/bundled.cjs"
    },
    "./spz/bundled": {
      "types": "./dist/spz/bundled-entry.d.ts",
      "import": "./dist/spz/bundled-entry.js",
      "require": "./dist/spz/bundled-entry.cjs"
    },
    "./rad/api": {
      "types": "./dist/rad/api.d.ts",
      "import": "./dist/rad/api.js",
      "require": "./dist/rad/api.cjs"
    },
    "./spz/api": {
      "types": "./dist/spz/api.d.ts",
      "import": "./dist/spz/api.js",
      "require": "./dist/spz/api.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "pre-build": "npm run generate-json-schema && npm run build-bundle && npm run build-bundle-dev",
    "generate-json-schema": "node ../../scripts/generate-json-schema.mjs --schema ./dist/rad-zod-schema.js --export RADMetadataJSONSchema --output ./dist/rad-metadata.schema.json --id https://unpkg.com/@loaders.gl/splats/rad-metadata.schema.json --title 'loaders.gl Spark RAD metadata' && node ../../scripts/generate-json-schema.mjs --schema ./dist/rad-zod-schema.js --export RADChunkMetadataJSONSchema --output ./dist/radc-metadata.schema.json --id https://unpkg.com/@loaders.gl/splats/radc-metadata.schema.json --title 'loaders.gl Spark RADC chunk metadata'",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "dependencies": {
    "@loaders.gl/compression": "5.0.1",
    "apache-arrow": ">= 17.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "zstd-codec": "^0.1.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
