{
  "name": "@loaders.gl/graphs",
  "version": "5.0.0-beta.2",
  "description": "Graph loaders for Graphviz DOT, GraphML, and GEXF",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "graph",
    "dot",
    "graphml",
    "gexf",
    "parser",
    "loader",
    "loaders.gl"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./graphml-loader": {
      "types": "./dist/graphml-loader.d.ts",
      "import": "./dist/graphml-loader.js",
      "require": "./dist/graphml-loader.cjs"
    },
    "./dot-loader": {
      "types": "./dist/dot-loader.d.ts",
      "import": "./dist/dot-loader.js",
      "require": "./dist/dot-loader.cjs"
    },
    "./gexf-loader": {
      "types": "./dist/gexf-loader.d.ts",
      "import": "./dist/gexf-loader.js",
      "require": "./dist/gexf-loader.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "pre-build": "npm run build-metadata",
    "build-metadata": "node ../../scripts/build-graphs-metadata.mjs"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "f1a6da2c65e4ea06b59c61d1884819b6be577fe3",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@loaders.gl/documents": "5.0.0-beta.2",
    "apache-arrow": ">= 17.0.0"
  }
}
