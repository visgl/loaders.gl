{
  "name": "@loaders.gl/zip",
  "version": "5.0.0-alpha.13",
  "description": "Zip Archive Loader",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "archive",
    "ZIP"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./zip-writer": {
      "types": "./dist/zip-writer.d.ts",
      "import": "./dist/zip-writer.js",
      "require": "./dist/zip-writer.cjs"
    },
    "./indexed-zip-writer": {
      "types": "./dist/indexed-zip-writer.d.ts",
      "import": "./dist/indexed-zip-writer.js",
      "require": "./dist/indexed-zip-writer.cjs"
    },
    "./zip-encode": {
      "types": "./dist/zip-encode.d.ts",
      "import": "./dist/zip-encode.js",
      "require": "./dist/zip-encode.cjs"
    },
    "./zip-loader": {
      "types": "./dist/zip-loader.d.ts",
      "import": "./dist/zip-loader.js",
      "require": "./dist/zip-loader.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "dependencies": {
    "@loaders.gl/compression": "5.0.0-alpha.13",
    "@loaders.gl/crypto": "5.0.0-alpha.13"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
