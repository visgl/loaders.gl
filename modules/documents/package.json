{
  "name": "@loaders.gl/documents",
  "version": "5.0.0-rc.2",
  "description": "Native XML, HTML, JSON, YAML, TOML, BSON, and Markdown document loaders",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "loaders.gl",
    "XML",
    "HTML",
    "YAML",
    "TOML",
    "BSON",
    "Markdown"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./xml-parser": {
      "types": "./dist/xml-parser.d.ts",
      "import": "./dist/xml-parser.js",
      "require": "./dist/xml-parser.cjs"
    },
    "./xml-utils": {
      "types": "./dist/xml-utils.d.ts",
      "import": "./dist/xml-utils.js",
      "require": "./dist/xml-utils.cjs"
    },
    "./sax-parser": {
      "types": "./dist/sax-parser.d.ts",
      "import": "./dist/sax-parser.js",
      "require": "./dist/sax-parser.cjs"
    },
    "./bson-codec": {
      "types": "./dist/bson-codec.d.ts",
      "import": "./dist/bson-codec.js",
      "require": "./dist/bson-codec.cjs"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "require": "./dist/json.cjs"
    },
    "./xml": {
      "types": "./dist/xml.d.ts",
      "import": "./dist/xml.js",
      "require": "./dist/xml.cjs"
    },
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js",
      "require": "./dist/html.cjs"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js",
      "require": "./dist/yaml.cjs"
    },
    "./toml": {
      "types": "./dist/toml.d.ts",
      "import": "./dist/toml.js",
      "require": "./dist/toml.cjs"
    },
    "./bson": {
      "types": "./dist/bson.d.ts",
      "import": "./dist/bson.js",
      "require": "./dist/bson.cjs"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "require": "./dist/markdown.cjs"
    },
    "./json/bundled": {
      "types": "./dist/json-bundled.d.ts",
      "import": "./dist/json-bundled.js",
      "require": "./dist/json-bundled.cjs"
    },
    "./xml/bundled": {
      "types": "./dist/xml-bundled.d.ts",
      "import": "./dist/xml-bundled.js",
      "require": "./dist/xml-bundled.cjs"
    },
    "./html/bundled": {
      "types": "./dist/html-bundled.d.ts",
      "import": "./dist/html-bundled.js",
      "require": "./dist/html-bundled.cjs"
    },
    "./yaml/bundled": {
      "types": "./dist/yaml-bundled.d.ts",
      "import": "./dist/yaml-bundled.js",
      "require": "./dist/yaml-bundled.cjs"
    },
    "./toml/bundled": {
      "types": "./dist/toml-bundled.d.ts",
      "import": "./dist/toml-bundled.js",
      "require": "./dist/toml-bundled.cjs"
    },
    "./bson/bundled": {
      "types": "./dist/bson-bundled.d.ts",
      "import": "./dist/bson-bundled.js",
      "require": "./dist/bson-bundled.cjs"
    },
    "./markdown/bundled": {
      "types": "./dist/markdown-bundled.d.ts",
      "import": "./dist/markdown-bundled.js",
      "require": "./dist/markdown-bundled.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "pre-build": "npm run build-metadata",
    "build-metadata": "node ../../scripts/build-documents-metadata.mjs"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
