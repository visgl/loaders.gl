{
  "name": "@loaders.gl/archives",
  "version": "5.0.0-beta.1",
  "description": "ZIP and TAR archive loaders and writers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "archive",
    "ZIP",
    "TAR",
    "loaders.gl"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./zip": {
      "types": "./dist/zip/index.d.ts",
      "import": "./dist/zip/index.js",
      "require": "./dist/zip/index.cjs"
    },
    "./zip/zip-writer": {
      "types": "./dist/zip/zip-writer.d.ts",
      "import": "./dist/zip/zip-writer.js",
      "require": "./dist/zip/zip-writer.cjs"
    },
    "./zip/indexed-zip-writer": {
      "types": "./dist/zip/indexed-zip-writer.d.ts",
      "import": "./dist/zip/indexed-zip-writer.js",
      "require": "./dist/zip/indexed-zip-writer.cjs"
    },
    "./zip/zip-encode": {
      "types": "./dist/zip/zip-encode.d.ts",
      "import": "./dist/zip/zip-encode.js",
      "require": "./dist/zip/zip-encode.cjs"
    },
    "./zip/zip-loader": {
      "types": "./dist/zip/zip-loader.d.ts",
      "import": "./dist/zip/zip-loader.js",
      "require": "./dist/zip/zip-loader.cjs"
    },
    "./tar": {
      "types": "./dist/tar/index.d.ts",
      "import": "./dist/tar/index.js",
      "require": "./dist/tar/index.cjs"
    },
    "./tar/tar-loader": {
      "types": "./dist/tar/tar-loader.d.ts",
      "import": "./dist/tar/tar-loader.js",
      "require": "./dist/tar/tar-loader.cjs"
    },
    "./tar/tar-writer": {
      "types": "./dist/tar/tar-writer.d.ts",
      "import": "./dist/tar/tar-writer.js",
      "require": "./dist/tar/tar-writer.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "dependencies": {
    "@loaders.gl/compression": "5.0.0-beta.1",
    "@loaders.gl/crypto": "5.0.0-beta.1"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
