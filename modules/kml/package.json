{
  "name": "@loaders.gl/kml",
  "version": "5.0.0-alpha.12",
  "description": "Framework-independent loader for the KML format",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "mesh",
    "point cloud",
    "KML"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./unbundled": {
      "types": "./dist/unbundled.d.ts",
      "import": "./dist/unbundled.js"
    },
    "./bundled": {
      "types": "./dist/bundled.d.ts",
      "import": "./dist/bundled.js"
    },
    "./kmz-loader": {
      "types": "./dist/kmz-loader.d.ts",
      "import": "./dist/kmz-loader.js"
    },
    "./kml-loader": {
      "types": "./dist/kml-loader-entry.d.ts",
      "import": "./dist/kml-loader-entry.js"
    },
    "./gpx-loader": {
      "types": "./dist/gpx-loader-entry.d.ts",
      "import": "./dist/gpx-loader-entry.js"
    },
    "./tcx-loader": {
      "types": "./dist/tcx-loader-entry.d.ts",
      "import": "./dist/tcx-loader-entry.js"
    }
  },
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "pre-build": "npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "dependencies": {
    "@loaders.gl/geospatial": "5.0.0-alpha.12"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  },
  "gitHead": "8a9e77743ea90a7be4ebec572416bb50ca9d73c3"
}
