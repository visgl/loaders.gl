import {expect, test} from 'vitest';
import {fromFile} from 'geotiff';
// import {getDecoder} from 'geotiff/src/compression';

// import {createPoolProxy, createOffsetsProxy} from '../../src/geotiff/tiff/lib/proxies';
import {createPoolProxy, createOffsetsProxy} from '../../src/geotiff/tiff/lib/proxies';

/*
 * rollup-plugin-web-worker-loader relies on `atob` which isn't in Node.
 * This is a shim for "Pool" for testing the proxies.
 */
// biome-ignore format: preserve intentional fixture layout
const pool = /** @type {import('../../src/geotiff/tiff/lib/Pool').default}} */ ({
  async decode(fileDirectory, buffer) {
    const decoder = getDecoder(fileDirectory);
    const result = await decoder.decode(fileDirectory, buffer);
    return result;
  }
});

test.skip('Inspect tiff proxies.', async () => {
  let tiff = await fromFile('tests/loaders/fixtures/multi-channel.ome.tif');
  expect(tiff['__viv-decoder-pool'], 'Regular tiff should not have any proxies.').toBe(undefined);
  expect(tiff['__viv-offsets'], 'Regular tiff should not have any proxies.').toBe(undefined);

  tiff = createPoolProxy(tiff, pool);
  expect(tiff['__viv-decoder-pool'], 'Should have pool proxy.').toBe(true);
  expect(tiff['__viv-offsets'], 'Should not have offsets proxy.').toBe(undefined);

  tiff = createOffsetsProxy(tiff, []);
  expect(tiff['__viv-decoder-pool'], 'Should have pool proxy.').toBe(true);
  expect(tiff['__viv-offsets'], 'Should have both proxies.').toBe(true);
});
