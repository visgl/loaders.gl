{
  "name": "@loaders.gl/pointclouds",
  "version": "5.0.0",
  "description": "LAS, LAZ, PCD, and PLY point cloud and mesh loaders and writers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "mesh",
    "point cloud",
    "LAS",
    "LAZ",
    "loaders.gl",
    "PCD",
    "PLY"
  ],
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./las": {
      "types": "./dist/las/metadata-entry.d.ts",
      "import": "./dist/las/metadata-entry.js",
      "require": "./dist/las/metadata-entry.cjs"
    },
    "./las/parser": {
      "types": "./dist/las/las-loader.d.ts",
      "import": "./dist/las/las-loader.js",
      "require": "./dist/las/las-loader.cjs"
    },
    "./las/bundled": {
      "types": "./dist/las/bundled.d.ts",
      "import": "./dist/las/bundled.js",
      "require": "./dist/las/bundled.cjs"
    },
    "./pcd": {
      "types": "./dist/pcd/metadata-entry.d.ts",
      "import": "./dist/pcd/metadata-entry.js",
      "require": "./dist/pcd/metadata-entry.cjs"
    },
    "./pcd/parser": {
      "types": "./dist/pcd-loader.d.ts",
      "import": "./dist/pcd-loader.js",
      "require": "./dist/pcd-loader.cjs"
    },
    "./pcd/bundled": {
      "types": "./dist/pcd/bundled.d.ts",
      "import": "./dist/pcd/bundled.js",
      "require": "./dist/pcd/bundled.cjs"
    },
    "./ply": {
      "types": "./dist/ply/metadata-entry.d.ts",
      "import": "./dist/ply/metadata-entry.js",
      "require": "./dist/ply/metadata-entry.cjs"
    },
    "./ply/parser": {
      "types": "./dist/ply-loader.d.ts",
      "import": "./dist/ply-loader.js",
      "require": "./dist/ply-loader.cjs"
    },
    "./ply/bundled": {
      "types": "./dist/ply/bundled.d.ts",
      "import": "./dist/ply/bundled.js",
      "require": "./dist/ply/bundled.cjs"
    },
    "./las-worker.js": {
      "import": "./dist/las-worker.js"
    },
    "./pcd-worker.js": {
      "import": "./dist/pcd-worker.js"
    },
    "./ply-worker.js": {
      "import": "./dist/ply-worker.js"
    },
    "./las/writer": {
      "types": "./dist/las/las-writer.d.ts",
      "import": "./dist/las/las-writer.js",
      "require": "./dist/las/las-writer.cjs"
    },
    "./las/api": {
      "types": "./dist/las/api.d.ts",
      "import": "./dist/las/api.js",
      "require": "./dist/las/api.cjs"
    }
  },
  "sideEffects": false,
  "browser": {
    "crypto": false,
    "fs": false,
    "path": false,
    "ws": false
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LAS-README.md",
    "PCD-README.md",
    "PLY-README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "third-party-licenses"
  ],
  "scripts": {
    "build-worker-las": "esbuild src/las/workers/las-worker.ts --bundle --outfile=dist/las-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-pcd": "node ../../scripts/build-codec-worker.mjs src/pcd/workers/pcd-worker.ts --bundle --outfile=dist/pcd-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-worker-ply": "node ../../scripts/build-codec-worker.mjs src/ply/workers/ply-worker.ts --bundle --outfile=dist/ply-worker.js --define:__VERSION__=\\\"$npm_package_version\\\"",
    "build-format-subpaths": "node ../../scripts/build-format-subpaths.mjs",
    "pre-build": "npm run build-worker-las && npm run build-worker-pcd && npm run build-worker-ply && npm run build-format-subpaths && npm run build-bundle && npm run build-bundle-dev",
    "build-bundle": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --output=dist/dist.min.js",
    "build-bundle-dev": "node ../../scripts/build-codec-bundle.mjs ./bundle.ts --env=dev --output=dist/dist.dev.js"
  },
  "dependencies": {
    "@math.gl/geospatial": "^5.0.4",
    "apache-arrow": ">= 17.0.0"
  },
  "peerDependencies": {
    "@loaders.gl/core": "~5.0.0-alpha.0"
  }
}
