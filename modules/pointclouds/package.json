{
  "name": "@loaders.gl/pointclouds",
  "version": "5.0.0-beta.1",
  "description": "LAS, LAZ, PCD, and PLY point cloud and mesh loaders and writers",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
