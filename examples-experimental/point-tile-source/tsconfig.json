{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "../..",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["react", "react-dom"],
    "paths": {
      "@loaders.gl/potree": ["modules/potree/src"]
    }
