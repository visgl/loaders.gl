{
  "name": "loaders.gl",
  "description": "Framework-independent loaders for visualization, 3D graphics and geospatial formats",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/loaders.gl"
  },
  "keywords": [
    "webgl",
    "loader",
    "3d",
    "point cloud",
    "GLB",
    "OBJ",
    "PLY",
    "LAZ",
    "PCD",
    "KML"
  ],
  "workspaces": [
    "modules/*",
    "apps/*",
    "examples/**",
    "website"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "bootstrap": "ocular-bootstrap",
    "postinstall": "echo postinstall",
    "start": "echo 'Please see loaders.gl website for how to run examples' && open https://loaders.gl/docs",
    "serve-range": "node ./scripts/range-server.mjs",
    "clean": "ocular-clean",
    "tsclean": "find . -name tsconfig.tsbuildinfo -exec rm {} \\;",
    "build": "yarn build-modules",
    "build-modules": "ocular-clean && node ./scripts/build-modules-parallel.mjs && npx lerna run pre-build",
    "build-apps": "node ./scripts/run-app-commands.mjs build",
    "build-workers": "node ./scripts/build-workers.mjs",
    "cover": "yarn test-cover",
    "lint": "ocular-lint",
    "publish-beta": "ocular-publish version-only-beta",
    "publish-prod": "ocular-publish version-only-prod",
    "test": "node ./scripts/test.mjs full",
    "test-modules": "node ./scripts/test.mjs full",
    "test-apps": "node ./scripts/run-app-commands.mjs test",
    "test-node": "node ./scripts/test.mjs node",
    "test-browser": "node ./scripts/test.mjs browser",
    "test-headless": "node ./scripts/test.mjs browser-headless",
    "test-node-cover": "node ./scripts/test.mjs cover-node",
    "test-headless-cover": "node ./scripts/test.mjs cover-headless",
    "test-slow": "node ./scripts/test.mjs slow",
    "test-slow-cover": "node ./scripts/test.mjs cover-slow",
    "test-slow-affected": "node ./scripts/run-affected-slow-tests.mjs",
    "test-slow-affected-cover": "node ./scripts/run-affected-slow-tests.mjs --coverage",
    "test-external": "node ./scripts/test.mjs external",
    "test-audit": "node ./scripts/audit-tests.mjs",
    "test-profile": "node ./scripts/run-test-profile.mjs",
    "test-coverage-check": "node ./scripts/check-coverage-thresholds.mjs",
    "test-coverage-ratchet": "node ./scripts/check-coverage-thresholds.mjs --update",
    "test-vitest-async-guardrails": "node ./scripts/check-vitest-async-guardrails.mjs",
    "playwright:install": "playwright install chromium",
    "test-cover": "node ./scripts/test.mjs cover",
    "bench": "node ./scripts/run-node-bench.mjs",
    "bench-browser": "node ./scripts/run-browser-bench.mjs",
    "bench-headless": "node ./scripts/run-browser-bench.mjs --headless",
    "test-website": "cd website && yarn && yarn build && cd ..",
    "test-fast": "yarn lint && yarn test-node",
    "pre-commit": "yarn lint",
    "pre-push": "yarn lint",
    "metrics": "./scripts/metrics.sh && ocular-metrics"
  },
  "devDependencies": {
    "@probe.gl/bench": "^4.1.1",
    "@probe.gl/env": "^4.1.1",
    "@probe.gl/test-utils": "^4.1.1",
    "@types/node": "^25.3.0",
    "@vis.gl/dev-tools": "2.0.0-alpha.6",
    "@vis.gl/ts-plugins": "2.0.0-alpha.6",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "playwright": "^1.59.1",
    "pre-commit": "^1.2.2",
    "pre-push": "^0.1.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.18",
    "zod": "^4.1.12"
  },
  "pre-commit": "pre-commit",
  "pre-push": "pre-push",
  "resolutions_notes": [
    "Ensure we use recent typescript",
    "apache-arrow version should be aligned with parquet-wasm version"
  ],
  "resolutions": {
    "apache-arrow": "^21.2.0",
    "typescript": "^6.0.3",
    "@loaders.gl/3d-tiles": "^5.0.0-alpha.0",
    "@loaders.gl/compression": "^5.0.0-alpha.0",
    "@loaders.gl/core": "^5.0.0-alpha.0",
    "@loaders.gl/crypto": "^5.0.0-alpha.0",
    "@loaders.gl/draco": "^5.0.0-alpha.0",
    "@loaders.gl/geopackage": "^5.0.0-alpha.0",
    "@loaders.gl/gis": "^5.0.0-alpha.0",
    "@loaders.gl/gltf": "^5.0.0-alpha.0",
    "@loaders.gl/images": "^5.0.0-alpha.0",
    "@loaders.gl/i3s": "^5.0.0-alpha.0",
    "@loaders.gl/las": "^5.0.0-alpha.0",
    "@loaders.gl/loader-utils": "^5.0.0-alpha.0",
    "@loaders.gl/math": "^5.0.0-alpha.0",
    "@loaders.gl/mvt": "^5.0.0-alpha.0",
    "@loaders.gl/obj": "^5.0.0-alpha.0",
    "@loaders.gl/ply": "^5.0.0-alpha.0",
    "@loaders.gl/splats": "^5.0.0-alpha.0",
    "@loaders.gl/sql": "^5.0.0-alpha.0",
    "@loaders.gl/schema": "^5.0.0-alpha.0",
    "@loaders.gl/schema-utils": "^5.0.0-alpha.0",
    "@loaders.gl/scene": "^5.0.0-alpha.0",
    "@loaders.gl/terrain": "^5.0.0-alpha.0",
    "@loaders.gl/textures": "^5.0.0-alpha.0",
    "@loaders.gl/tiles": "^5.0.0-alpha.0",
    "@loaders.gl/traces": "^5.0.0-alpha.0",
    "@loaders.gl/worker-utils": "^5.0.0-alpha.0",
    "@loaders.gl/wms": "^5.0.0-alpha.0",
    "@loaders.gl/zip": "^5.0.0-alpha.0"
  }
}
