  "scripts": {
    "bootstrap": "ocular-bootstrap",
    "postinstall": "echo postinstall",
    "start": "echo 'Please see loaders.gl website for how to run examples' && open https://loaders.gl/docs",
    "serve-range": "node ./scripts/range-server.mjs",
    "clean": "ocular-clean",
    "tsclean": "find . -name tsconfig.tsbuildinfo -exec rm {} \\;",
    "build": "yarn build-modules",
    "build-modules": "node ./scripts/build-modules-parallel.mjs",
    "build-apps": "node ./scripts/run-app-commands.mjs build",
    "build-workers": "node ./scripts/build-workers.mjs",
    "cover": "yarn test-cover",
    "lint": "ocular-lint",
    "publish-beta": "ocular-publish version-only-beta",
    "publish-prod": "ocular-publish version-only-prod",
    "test": "node ./scripts/test.mjs full",
    "test-modules": "node ./scripts/test.mjs full",
    "test-apps": "node ./scripts/run-app-commands.mjs test",
    "test-node": "node ./scripts/test.mjs node",
    "test-tile-converter": "node ./scripts/test.mjs tile-converter",
    "test-browser": "node ./scripts/test.mjs browser",
    "test-headless": "node ./scripts/test.mjs browser-headless",
    "test-node-cover": "node ./scripts/test.mjs cover-node",
    "test-headless-cover": "node ./scripts/test.mjs cover-headless",
    "test-slow": "node ./scripts/test.mjs slow",
    "test-slow-cover": "node ./scripts/test.mjs cover-slow",
    "test-slow-affected": "node ./scripts/run-affected-slow-tests.mjs",
    "test-slow-affected-cover": "node ./scripts/run-affected-slow-tests.mjs --coverage",
    "test-external": "node ./scripts/test.mjs external",
    "test-audit": "node ./scripts/audit-tests.mjs",
    "test-profile": "node ./scripts/run-test-profile.mjs",
    "test-coverage-check": "node ./scripts/check-coverage-thresholds.mjs",
    "test-coverage-summary": "node ./scripts/write-coverage-summary.mjs",
    "test-coverage-ratchet": "node ./scripts/check-coverage-thresholds.mjs --update",
    "test-vitest-async-guardrails": "node ./scripts/check-vitest-async-guardrails.mjs",
    "playwright:install": "playwright install chromium",
    "test-cover": "node ./scripts/test.mjs cover",
    "bench": "node ./scripts/run-node-bench.mjs",
    "bench-browser": "node ./scripts/run-browser-bench.mjs",
    "bench-headless": "node ./scripts/run-browser-bench.mjs --headless",
    "test-website": "cd website && yarn && yarn build && cd ..",
    "test-fast": "yarn lint && yarn test-node",
    "pre-commit": "yarn lint",
    "pre-push": "yarn lint",
    "metrics": "./scripts/metrics.sh && ocular-metrics",
    "check-attributions": "node ./scripts/check-attributions.mjs"
