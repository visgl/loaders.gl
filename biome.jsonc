{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
  "extends": ["@vis.gl/dev-tools/biome.jsonc"],
  "files": {
    "includes": [
      "modules/**/*.js",
      "modules/**/*.jsx",
      "modules/**/*.ts",
      "modules/**/*.tsx",
      "apps/**/*.js",
      "apps/**/*.jsx",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "dev-docs/**/*.js",
      "dev-docs/**/*.jsx",
      "dev-docs/**/*.ts",
      "dev-docs/**/*.tsx",
      "docs/**/*.js",
      "docs/**/*.jsx",
      "docs/**/*.ts",
      "docs/**/*.tsx",
      "test/**/*.js",
      "test/**/*.jsx",
      "test/**/*.ts",
      "test/**/*.tsx",
      "!**/*.min.js",
      "!**/*.minified.js",
      "!**/dist/**",
      "!**/wip/**",
      "!**/.cache/**",
      "!**/public/**",
      "!**/src/libs/**",
      "!modules/pointclouds/src/las/libs/**",
      "!modules/scene/src/gltf/libs/**",
      "!modules/raster/src/terrain/libs/**",
      "!modules/raster/src/lerc/libs/**",
      "!test/apps/**",
      "!modules/core/src/iterators/make-stream/make-node-stream.ts",
      "!modules/core/src/loader-utils/lib/files/node-file-facade.ts",
      "!modules/core/src/loader-utils/lib/filesystems/node-filesystem-facade.ts",
      "!modules/documents/test/bson/data/js-bson/corrupt.ts",
      "!modules/tables/test/parquet/**",
      "!modules/geospatial/src/flatgeobuf/flatgeobuf*",
      "!modules/geospatial/src/flatgeobuf/lib/binary-geometries.ts",
      "!modules/tiles-3d/test/potree/data/**/cloud.js",
      "!modules/tiles/src/bundle.ts",
      "!modules/scientific/src/zarr/**",
      "!modules/images/src/lib/category-api/image-type.ts",
      "!modules/images/test/image-loader.spec.ts",
      "!modules/scene/src/obj/lib/get-obj-schema.ts",
      "!modules/images/test/textures/basis-loader.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/attribute-name.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/opentagstart.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/script-close-better.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/script.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/xmlns-unbound.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/xmlns-xml-default-ns.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/xmlns-xml-default-prefix-attribute.spec.ts",
      "!modules/documents/test/xml/sax-ts/testcases/xmlns-xml-default-redefine.spec.ts",
      "!modules/ogc/src/wms/lib/data-sources/ogc/csw-service.ts",
      "!modules/ogc/src/wms/lib/parsers/gml/parse-gml.ts",
      "!modules/ogc/src/wms/lib/wip/**",
      "!modules/ogc/src/wms/wms-layer-description-loader.ts",
      "!modules/ogc/test/wms/data/wms/errors.ts",
      "!modules/ogc/test/wms/wms/wms-error-loader.spec.ts",
      "!modules/ogc/test/wms/wms-feature-info-loader.spec.ts",
      "!modules/ogc/test/wms/wms/wms-feature-info-loader.spec.ts",
      "!modules/ogc/test/wms/wmts/wmts-capabilities-loader.spec.ts",
      "!modules/ogc/test/wms/wfs/wfs-capabilities-loader.spec.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "bracketSpacing": false
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "bracketSpacing": false
    }
  },
  "linter": {
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedImports": "warn",
        "noUnusedVariables": "warn",
        "noUnreachable": "error"
      },
      "suspicious": {
        "noAssignInExpressions": "error",
        "noAsyncPromiseExecutor": "error",
        "noConsole": "off",
        "noDebugger": "error",
        "noDoubleEquals": "error",
        "noGlobalIsNan": "error",
        "noRedeclare": "error",
        "noShadowRestrictedNames": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "modules/*/src/**/*.js",
        "modules/*/src/**/*.jsx",
        "modules/*/src/**/*.ts",
        "modules/*/src/**/*.tsx",
        "!modules/core/**",
        "!modules/deck-layers/**",
        "!modules/*/src/wip/**",
        "!modules/*/src/libs/**",
        "!modules/core/src/loader-utils/lib/files/node-file-facade.ts",
        "!modules/core/src/loader-utils/lib/filesystems/node-filesystem-facade.ts",
        "!modules/geospatial/src/flatgeobuf/flatgeobuf*",
        "!modules/geospatial/src/flatgeobuf/lib/binary-geometries.ts",
        "!modules/scientific/src/zarr/**",
        "!modules/images/src/lib/category-api/image-type.ts",
        "!modules/scene/src/obj/lib/get-obj-schema.ts",
        "!modules/ogc/src/wms/lib/data-sources/ogc/csw-service.ts",
        "!modules/ogc/src/wms/lib/parsers/gml/parse-gml.ts",
        "!modules/ogc/src/wms/lib/wip/**",
        "!modules/ogc/src/wms/wms-layer-description-loader.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@loaders.gl/core": "Published modules must not import @loaders.gl/core from src/**. Move shared helpers to a lower-level module or inject the dependency instead."
                }
              }
            }
          }
        }
      }
    }
  ]
}
