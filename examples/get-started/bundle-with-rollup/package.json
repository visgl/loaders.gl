{
  "name": "bundle-with-rollup",
  "version": "0.0.0",
  "description": "Bundle glTF loading with loaders.gl and Rollup",
  "private": true,
  "license": "MIT",
  "type": "module",
  "contributors": [
    "@nshen"
  ],
  "scripts": {
    "start": "yarn build; serve",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "serve": "serve public"
  },
  "dependencies": {
    "@loaders.gl/core": "workspace:*",
    "@loaders.gl/scene": "workspace:*"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^4.0.3",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "rollup": "^3.17.0",
    "serve": "^14.2.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "loaders.gl",
    "glTF",
    "GLB"
  ]
}
