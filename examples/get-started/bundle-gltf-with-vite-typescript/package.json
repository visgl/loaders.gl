{
  "name": "bundle-gltf-with-vite-typescript",
  "version": "0.0.0",
  "description": "Bundle glTF loading with loaders.gl and Vite",
  "private": true,
  "license": "MIT",
  "type": "module",
  "contributors": [
    "@nshen"
  ],
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview"
  },
  "dependencies": {
    "@loaders.gl/core": "workspace:*",
    "@loaders.gl/images": "workspace:*",
    "@loaders.gl/scene": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  },
  "keywords": [
    "loaders.gl",
    "glTF",
    "GLB"
  ]
}
