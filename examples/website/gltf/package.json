{
  "private": true,
  "name": "gltf-loaders-example",
  "description": "Load glTF scenes with loaders.gl and render them with luma.gl",
  "contributors": [
    "Georgios Karnas <georgios@uber.com>"
  ],
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview"
  },
  "dependencies": {
    "@deck.gl/core": "10.0.0-alpha.1",
    "@deck.gl/mesh-layers": "10.0.0-alpha.1",
    "@deck.gl/react": "10.0.0-alpha.1",
    "@loaders.gl/core": "workspace:*",
    "@loaders.gl/scene": "workspace:*",
    "@luma.gl/core": "10.0.0-alpha.14",
    "@luma.gl/engine": "10.0.0-alpha.14",
    "@luma.gl/shaders": "10.0.0-alpha.14",
    "@math.gl/core": "5.0.0-beta.10",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^8.3.5"
  },
  "keywords": [
    "loaders.gl",
    "glTF",
    "GLB"
  ]
}
