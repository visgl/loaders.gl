{
  "private": true,
  "name": "i3s-slpk-loaders-example",
  "description": "Render local and remote SLPK and 3TZ archives in the browser",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview"
  },
  "dependencies": {
    "@deck.gl/core": "10.0.0-alpha.1",
    "@deck.gl/react": "10.0.0-alpha.1",
    "@loaders.gl/core": "workspace:*",
    "@loaders.gl/deck-layers": "workspace:*",
    "@loaders.gl/scene": "workspace:*",
    "@loaders.gl/tile-converter": "workspace:*",
    "@loaders.gl/tiles": "workspace:*",
    "@loaders.gl/tiles-3d": "workspace:*",
    "@math.gl/geospatial": "5.0.0-beta.10",
    "maplibre-gl": "^6.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-gl": "^8.1.3",
    "styled-components": "^5.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
