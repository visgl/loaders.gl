{
  "include": ["./app.tsx", "./examples.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@loaders.gl/*": ["../../../modules/*/dist"]
    },
    "jsx": "react-jsx"
  }
}
